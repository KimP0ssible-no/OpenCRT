<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>OpenCRT third-party notices</title>
<style>
  body { font-family: sans-serif; max-width: 960px; margin: 2em auto; padding: 0 1em; }
  pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
  li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Third-party notices</h1>
<p>OpenCRT is built on the following open-source Rust crates. Each is used
under the licence shown with it.</p>
<h2>Licences used</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}} crates)</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
