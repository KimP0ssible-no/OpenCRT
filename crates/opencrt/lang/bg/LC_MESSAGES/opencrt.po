msgstr "Тип"

#: crates/opencrt/ui/main.slint:2376 crates/opencrt/ui/main.slint:2481
msgid "Listen"
msgstr "Слушане"

#: crates/opencrt/ui/main.slint:2377 crates/opencrt/ui/main.slint:2509
msgid "Destination"
msgstr "Местоназначение"

#: crates/opencrt/ui/main.slint:2378 crates/opencrt/ui/main.slint:2528
msgid "Application"
msgstr "Приложение"

#: crates/opencrt/ui/main.slint:2409 crates/opencrt/ui/main.slint:7114
