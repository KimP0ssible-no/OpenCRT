msgstr "např. === %S připojeno %Y-%M-%D %h:%m:%s ==="

#: crates/opencrt/ui/main.slint:2186
msgid "On disconnect:"
msgstr "Při odpojení:"

#: crates/opencrt/ui/main.slint:2190
