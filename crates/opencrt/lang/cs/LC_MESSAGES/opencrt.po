msgid ""
"Allow legacy algorithms (SHA-1 key exchange, CBC ciphers) for old devices"
msgstr "Povolit starší algoritmy (výměna klíčů SHA-1, šifry CBC) pro stará zařízení"

#: crates/opencrt/ui/main.slint:2022
