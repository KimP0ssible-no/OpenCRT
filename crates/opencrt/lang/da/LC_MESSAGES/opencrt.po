msgstr "Gem også en rå log (.raw ved siden af): bytes som modtaget, inklusive escape-sekvenser"

msgid "On connect:"
msgstr "Ved forbindelse:"

msgid "e.g. === %S connected %Y-%M-%D %h:%m:%s ==="
msgstr "f.eks. === %S forbundet %Y-%M-%D %h:%m:%s ==="

