msgid "The file is empty."
msgstr "Το αρχείο είναι κενό."

msgid "The first line must name the columns, including a host (or hostname) column."
msgstr "Η πρώτη γραμμή πρέπει να ονομάζει τις στήλες, μεταξύ αυτών μια στήλη host (ή hostname)."

msgid "Line {}: bad port \"{}\"."
msgstr "Γραμμή {}: μη έγκυρη θύρα «{}»."

msgid "Line {}: unknown protocol \"{}\"."
msgstr "Γραμμή {}: άγνωστο πρωτόκολλο «{}»."

msgid "Enter a folder name (without \"/\")."
msgstr "Πληκτρολογήστε όνομα φακέλου (χωρίς «/»)."

msgid "No SecureCRT sessions in {}. Pick the Config folder that contains the Sessions folder."
msgstr "Δεν υπάρχουν συνεδρίες SecureCRT στο {}. Επιλέξτε τον φάκελο Config που περιέχει τον φάκελο Sessions."

msgid "Credential \"{}\": {}; asking for the password instead."
msgstr "Διαπιστευτήριο «{}»: {}· ζητείται ο κωδικός πρόσβασης."

msgid "Update Now installs it and restarts OpenCRT."
msgstr "Το Ενημέρωση τώρα την εγκαθιστά και επανεκκινεί το OpenCRT."

msgid "Update it with your system's package manager."
msgstr "Ενημερώστε το με τη διαχείριση πακέτων του συστήματός σας."

msgid "To get it, and later versions, with your system's updates, set up the OpenCRT package repository once: kimp0ssible-no.github.io/OpenCRT"
msgstr "Για να τη λάβετε, μαζί με τις επόμενες εκδόσεις, με τις ενημερώσεις του συστήματός σας, ρυθμίστε μία φορά το αποθετήριο πακέτων του OpenCRT: kimp0ssible-no.github.io/OpenCRT"

msgid "Download the portable zip from the release page and replace the program files in this folder; the settings folder stays as it is."
msgstr "Κάντε λήψη του φορητού zip από τη σελίδα της έκδοσης και αντικαταστήστε τα αρχεία του προγράμματος σε αυτόν τον φάκελο· ο φάκελος ρυθμίσεων μένει ως έχει."

msgid "Download it from the release page."
msgstr "Κάντε λήψη από τη σελίδα της έκδοσης."

msgid "That is not the master password."
msgstr "Αυτός δεν είναι ο κύριος κωδικός πρόσβασης."

msgid "Username for {}:"
msgstr "Όνομα χρήστη για το {}:"

msgid "Password for {} on {}:"
msgstr "Κωδικός πρόσβασης για το {} στο {}:"
