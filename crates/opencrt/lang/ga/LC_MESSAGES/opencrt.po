msgid "{} wants to {}.\n\nUntil you trust a script, it may use files only in its own folder, the download folder and the log folder, and may not run programs or use the network.\n\nAllow once lets this run go on; Always trust lets the script do anything from now on, until it is changed."
msgstr "Is mian le {} {}.\n\nGo dtí go n-iontaobhaíonn tú script, ní féidir leis comhaid a úsáid ach ina fhillteán féin, san fhillteán íoslódála agus san fhillteán logála, agus ní féidir leis ríomhchláir a rith ná an líonra a úsáid.\n\nLigeann Ceadaigh uair amháin don rith seo leanúint ar aghaidh; ligeann Iontaobh an script seo i gcónaí don script aon rud a dhéanamh as seo amach, go dtí go n-athraítear é."

msgid "Allow once"
msgstr "Ceadaigh uair amháin"

msgid "Always trust this script"
msgstr "Iontaobh an script seo i gcónaí"

msgid "Stop"
msgstr "Stop"

msgid "Script Wants More Access"
msgstr "Teastaíonn Níos Mó Rochtana ón Script"

