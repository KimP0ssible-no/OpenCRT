msgid "Start each line with the date and time"
msgstr "Inizia ogni riga con data e ora"

msgid ""
"Also keep a raw log (.raw beside it): the bytes as received, escape "
"sequences included"
msgstr "Mantieni anche un log raw (.raw accanto): i byte così come ricevuti, sequenze di escape incluse"

msgid "On connect:"
msgstr "Alla connessione:"

msgid "e.g. === %S connected %Y-%M-%D %h:%m:%s ==="
msgstr "es. === %S connesso %Y-%M-%D %h:%m:%s ==="

msgid "On disconnect:"
msgstr "Alla disconnessione:"

msgid "Each line:"
msgstr "Ogni riga:"

