msgstr "메뉴 모음 표시(터미널을 마우스 오른쪽 버튼으로 클릭하면 다시 표시)"

msgid "Show connect bar"
msgstr "연결 표시줄 표시"

msgid "Show the server's load in the status bar (Linux hosts over SSH)"
msgstr "상태 표시줄에 서버 부하 표시(SSH로 연결한 Linux 호스트)"

msgid "Ask before closing a connected tab or exiting"
msgstr "연결된 탭을 닫거나 끝내기 전에 확인"

