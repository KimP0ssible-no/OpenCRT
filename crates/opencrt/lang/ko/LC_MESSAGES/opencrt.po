msgid "A firewall name cannot look like a proxy address."
msgstr "방화벽 이름은 프록시 주소처럼 보이면 안 됩니다."

msgid "Enter the command to run, e.g. nc %h %p."
msgstr "실행할 명령을 입력하십시오(예: nc %h %p)."

msgid "Enter the firewall's host name and port."
msgstr "방화벽의 호스트 이름과 포트를 입력하십시오."

msgid "For a proxy that needs a login, add a firewall in Options > Firewalls."
msgstr "로그인이 필요한 프록시는 옵션 > 방화벽에서 방화벽으로 추가하십시오."

msgid "load native code (ctypes)"
msgstr "네이티브 코드 로드(ctypes)"

msgid "use the Windows registry"
msgstr "Windows 레지스트리 사용"

msgid "change its limits"
msgstr "자체 제한 변경"

msgid "look through Python's memory"
msgstr "Python 메모리 조회"

msgid "signal another program (process {})"
msgstr "다른 프로그램에 신호 보내기(프로세스 {})"

msgid "use the network ({})"
msgstr "네트워크 사용({})"

msgid "write to {}"
msgstr "{}에 쓰기"

msgid "list the folder {}"
msgstr "{} 폴더의 목록 보기"

