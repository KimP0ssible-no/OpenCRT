msgstr "DEL 대신 Ctrl+H(^H) 전송"

msgid "Anti-idle text:"
msgstr "유휴 방지 텍스트:"

msgid "e.g. \\r, sent when no key is pressed for a while"
msgstr "예: \\r, 한동안 키 입력이 없을 때 전송"

msgid "Send an SSH keepalive or Telnet NOP instead of text"
msgstr "텍스트 대신 SSH keepalive 또는 Telnet NOP 전송"

msgid "Anti-idle every:"
msgstr "유휴 방지 간격:"

msgid "seconds (blank for off)"
msgstr "초(비워 두면 끔)"

msgid "Colour scheme:"
msgstr "색 구성표:"

msgid "Keyword set:"
msgstr "키워드 목록:"

