msgid "{} wants to {}.\n\nUntil you trust a script, it may use files only in its own folder, the download folder and the log folder, and may not run programs or use the network.\n\nAllow once lets this run go on; Always trust lets the script do anything from now on, until it is changed."
msgstr "{} prašo: {}.\n\nKol nepasitikite scenarijumi, jis gali naudoti failus tik savo aplanke, atsisiuntimų aplanke ir žurnalų aplanke, negali paleisti programų ir naudotis tinklu.\n\n„Leisti kartą“ leidžia šiam vykdymui tęstis; „Visada pasitikėti šiuo scenarijumi“ leidžia scenarijui daryti bet ką nuo šiol, kol jis nebus pakeistas."

msgid "Allow once"
msgstr "Leisti kartą"

msgid "Always trust this script"
msgstr "Visada pasitikėti šiuo scenarijumi"

