msgstr "piem., === %S savienots %Y-%M-%D %h:%m:%s ==="

#: crates/opencrt/ui/main.slint:2186
msgid "On disconnect:"
msgstr "Atvienojoties:"

#: crates/opencrt/ui/main.slint:2190
