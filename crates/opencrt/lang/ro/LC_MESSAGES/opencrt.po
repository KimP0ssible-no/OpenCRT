msgstr "Păstrează și un jurnal brut (.raw alături): octeții așa cum au fost primiți, inclusiv secvențele escape"

msgid "On connect:"
msgstr "La conectare:"

msgid "e.g. === %S connected %Y-%M-%D %h:%m:%s ==="
msgstr "ex. === %S connected %Y-%M-%D %h:%m:%s ==="

