msgstr "napr. \\r, odošle sa, keď sa chvíľu nestlačí žiadny kláves"

msgid "Send an SSH keepalive or Telnet NOP instead of text"
msgstr "Namiesto textu odoslať SSH keepalive alebo Telnet NOP"

msgid "Anti-idle every:"
msgstr "Proti nečinnosti každých:"

msgid "seconds (blank for off)"
msgstr "sekúnd (prázdne = vypnuté)"

