msgstr "зміна {}"

#: crates/opencrt/src/python.rs:277
msgid "{} wants to {}.\n\nUntil you trust a script, it may use files only in its own folder, the download folder and the log folder, and may not run programs or use the network.\n\nAllow once lets this run go on; Always trust lets the script do anything from now on, until it is changed."
msgstr "{} хоче виконати дію: {}.\n\nПоки ви не довіряєте сценарію, він може використовувати файли лише у власній папці, папці завантажень і папці журналів, а також не може запускати програми чи користуватися мережею.\n\n«Дозволити один раз» дає продовжити цей запуск; «Завжди довіряти» дозволяє сценарію робити будь-що відтепер, доки його не буде змінено."

#: crates/opencrt/src/python.rs:278
msgid "Allow once"
msgstr "Дозволити один раз"

#: crates/opencrt/src/python.rs:278
msgid "Always trust this script"
msgstr "Завжди довіряти цьому сценарію"

#: crates/opencrt/src/python.rs:278
msgid "Stop"
msgstr "Зупинити"

#: crates/opencrt/src/python.rs:280
msgid "Script Wants More Access"
msgstr "Сценарій запитує більше доступу"

#: crates/opencrt/src/python.rs:286
