msgid "Enter the firewall's host name and port."
msgstr "請輸入防火牆的主機名稱和連接埠。"

msgid "For a proxy that needs a login, add a firewall in Options > Firewalls."
msgstr "如果代理伺服器需要登入，請在「選項 > 防火牆」中加入防火牆。"

msgid "load native code (ctypes)"
msgstr "載入原生程式碼（ctypes）"

msgid "use the Windows registry"
msgstr "使用 Windows 登錄"

msgid "change its limits"
msgstr "變更自身的限制"

msgid "look through Python's memory"
msgstr "檢視 Python 的記憶體"

msgid "signal another program (process {})"
msgstr "向其他程式傳送訊號（處理序 {}）"

msgid "use the network ({})"
msgstr "使用網路（{}）"

msgid "write to {}"
msgstr "寫入 {}"

msgid "list the folder {}"
msgstr "列出資料夾 {}"

msgid "run a program: {}"
msgstr "執行程式：{}"

msgid "read {}"
msgstr "讀取 {}"

msgid "change {}"
msgstr "變更 {}"

msgid "{} wants to {}.\n\nUntil you trust a script, it may use files only in its own folder, the download folder and the log folder, and may not run programs or use the network.\n\nAllow once lets this run go on; Always trust lets the script do anything from now on, until it is changed."
msgstr "{} 想要{}。\n\n在您信任指令碼之前，它只能使用其所在資料夾、下載資料夾和記錄資料夾中的檔案，且不能執行程式或使用網路。\n\n「允許一次」會讓本次執行繼續；「一律信任」會讓該指令碼從現在起可執行任何動作，直到指令碼被修改為止。"

msgid "Allow once"
msgstr "允許一次"

msgid "Always trust this script"
msgstr "一律信任此指令碼"

msgid "Stop"
msgstr "停止"

msgid "Script Wants More Access"
msgstr "指令碼要求更多存取權"

msgid "Stopped: {} wanted to {}."
msgstr "已停止：{} 想要{}。"

msgid "Python stopped ({})"
msgstr "Python 已停止（{}）"

msgid "Password for {}@{}:"
msgstr "{}@{} 的密碼："

msgid "The saved password was not accepted ({}); enter it again."
msgstr "已儲存的密碼未被接受（{}）；請重新輸入。"

msgid "{} is not a fixed-width font."
msgstr "{} 不是等寬字型。"

msgid "The file is empty."
msgstr "檔案是空的。"

msgid "The first line must name the columns, including a host (or hostname) column."
msgstr "第一行必須是欄位名稱，並包含 host（或 hostname）欄。"

