msgstr "第 {} 行：連接埠「{}」無效。"

msgid "Line {}: unknown protocol \"{}\"."
msgstr "第 {} 行：未知的通訊協定「{}」。"

msgid "Enter a folder name (without \"/\")."
msgstr "請輸入資料夾名稱（不含「/」）。"

msgid "No SecureCRT sessions in {}. Pick the Config folder that contains the Sessions folder."
msgstr "{} 中沒有 SecureCRT 工作階段。請選擇含有 Sessions 資料夾的 Config 資料夾。"

