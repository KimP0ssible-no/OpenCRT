    in property <string> find-status;
    in property <[SessionRow]> session-rows;
    in property <bool> session-can-paste;
    in-out property <int> session-selected: -1;
    // Colour scheme names, and the same with "(global default)" first.
    in property <[string]> scheme-names;
    in-out property <int> sc-selected;
