    in property <[string]> scheme-choices;
    in property <[string]> so-keyword-set-choices;
    in-out property <int> so-keyword-set;

    // 0 none, 1 host key, 2 login prompt, 3 quick connect, 4 about,
    // 5 session options, 6 global options, 7 confirm, 8 name prompt
    in-out property <int> dialog: 0;
    in-out property <int> so-category;
    in-out property <string> so-name;
    in-out property <string> so-folder;
    in-out property <string> so-host;
