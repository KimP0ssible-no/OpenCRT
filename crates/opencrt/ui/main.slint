// OpenCRT main window: menu bar, toolbar with connect bar, session tabs, terminal,
// status bar and modal dialogs.

import { AboutSlint, Button, LineEdit, ComboBox, Palette, CheckBox, ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Icon, IconKind, Icons, SessionIcon } from "icons.slint";
import { Theme } from "theme.slint";
export { Theme }
import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-Medium.ttf";
import "fonts/IBMPlexSans-SemiBold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";

export struct TabData {
    title: string,
    // Tab group (0 leftmost), and whether it is the tab its group shows.
    group: int,
    shown: bool,
    // Output arrived while it was out of sight; a script is running; locked.
    activity: bool,
    scripting: bool,
    locked: bool,
    // Active Sessions: picked for a group action; filtered out.
    picked: bool,
    hidden: bool,
    // The tab's index (Active Sessions lists only the tabs its filter shows).
    index: int,
    // config::Protocol index, for the tab's icon.
    protocol: int,
    // 0 connecting, 1 connected, 2 disconnected or failed
    state: int,
    // The saved session's tab colour; transparent for none.
    color: color,
}

// A tab on screen: its image's place in the terminal area. Tiles (`titled`)
// also get a title bar above the image.
export struct PaneData {
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
    title: string,
    titled: bool,
    active: bool,
}

export struct PromptField {
    label: string,
    echo: bool,
}

// A Quick Open row: a saved session, or (typed) the address being typed.
export struct QuickRow {
    label: string,
    detail: string,
    protocol: int,
    typed: bool,
}

// File browser tabs: a row of the local or remote list.
export struct FileRow {
    name: string,
    size: string,
    kind: string,
    modified: string,
    permissions: string,
    owner: string,
    dir: bool,
    selected: bool,
}

// A row of the transfer queue.
export struct QueueRow {
    local: string,
    upload: bool,
    remote: string,
    size: string,
    status: string,
    // 0..1 while running, else -1.
    progress: float,
    selected: bool,
}

// A file browser tab on screen, drawn over its pane. Sorts are column * 2,
// plus 1 for descending; `list` is the queue list shown (waiting, failed, finished).
export struct FilesView {
    tab: int,
    x: length,
    y: length,
    width: length,
    height: length,
    local-dir: string,
    remote-dir: string,
    local-rows: [FileRow],
    remote-rows: [FileRow],
    local-status: string,
    remote-status: string,
    local-sort: int,
    remote-sort: int,
    local-filter: string,
    remote-filter: string,
    local-hidden: bool,
    remote-hidden: bool,
    queue: [QueueRow],
    list: int,
    waiting: int,
    failed: int,
    finished: int,
}

component ToolButton inherits Rectangle {
    in property <IconKind> icon;
    in property <bool> enabled: true;
    in property <length> icon-size: 16px;
    callback clicked;
    width: root.icon-size + 8px;
    height: self.width;
    border-radius: 3px;
    background: !root.enabled ? transparent : touch.pressed ? Theme.active-row-bg : touch.has-hover ? Theme.hover-bg : transparent;
    border-width: root.enabled && touch.has-hover ? 1px : 0px;
    border-color: Theme.border-strong;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.icon;
        enabled: root.enabled;
        size: root.icon-size;
    }
}

component ToolSeparator inherits Rectangle {
    width: 9px;
    Rectangle {
        x: 4px;
        y: 3px;
        width: 1px;
        height: parent.height - 6px;
        background: Theme.border;
    }
}

// Compact single-line input for toolbars and panels (the Fluent LineEdit is too tall).
component CompactInput inherits Rectangle {
    in property <string> placeholder;
    in property <bool> clear-on-submit: false;
    in-out property <string> text <=> input.text;
    callback submitted(string);
    callback edited(string);
    public function focus-input() {
        input.focus();
    }
    height: 20px;
    background: Theme.input-bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.focus-ring : Theme.border-strong;
    Text {
        x: 5px;
        height: parent.height;
        visible: input.text == "";
        text: root.placeholder;
        color: Theme.text-disabled;
        vertical-alignment: center;
        font-size: 11px;
    }
    input := TextInput {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        single-line: true;
        vertical-alignment: center;
        font-size: 12px;
        edited => { root.edited(self.text); }
        accepted => {
            root.submitted(self.text);
            if (root.clear-on-submit) {
                self.text = "";
            }
        }
    }
}

export struct CommandRow {
    label: string,
    text: string,
    folder: bool,
    expanded: bool,
    depth: int,
    // Index of the command in the saved list; -1 for a folder.
    index: int,
}

export struct CredentialRow {
    name: string,
    user: string,
}

export struct BarRow {
    label: string,
    color: color,
    // Index in the saved button list.
    index: int,
}

export struct ForwardRow {
    name: string,
    kind: string,
    listen: string,
    dest: string,
    app: string,
    enabled: bool,
}

export struct SessionRow {
    label: string,
    // A session's notes, first line.
    note: string,
    depth: int,
    folder: bool,
    expanded: bool,
    // An SSH2 session (it can open an SFTP tab).
    ssh: bool,
    // config::Protocol index, for the row's icon.
    protocol: int,
    // Picked with Ctrl+click (actions apply to all picked sessions).
    picked: bool,
}

component PanelHeader inherits Rectangle {
    in property <string> title;
    height: 26px;
    background: Theme.toolbar-bg;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

component SessionManagerPanel inherits Rectangle {
    in property <[SessionRow]> rows;
    in-out property <int> selected: -1;
    // Sessions have been cut or copied.
    in property <bool> can-paste;
    // Double-click: connect a session or expand/collapse a folder.
    callback activate(int);
    callback toggle(int);
    // A left click (Ctrl+click adds to or takes from the picked sessions).
    callback pick(int, bool);
    // Acts on `selected` (connect, cut and copy also on the picked sessions):
    // connect, edit, delete, cut, copy, paste, new-session, new-folder.
    callback action(string);
    // A key the list does not use; true if the terminal took it.
    callback pass-key(string, bool, bool, bool, bool) -> bool;
    // Scroll so the selected row (21px each) is in view.
    function show-selected() {
        if root.selected * 21px + session-list.content-y < 0 {
            session-list.content-y = -root.selected * 21px;
        }
        if (root.selected + 1) * 21px + session-list.content-y > session-list.visible-height {
            session-list.content-y = session-list.visible-height - (root.selected + 1) * 21px;
        }
    }
    callback filter-changed(string);
    background: Theme.input-bg;
    VerticalLayout {
        PanelHeader {
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 2px;
                padding-top: 1px;
                spacing: 0px;
                Text {
                    text: "Session Manager";
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                ToolButton {
                    icon: IconKind.connect;
                    enabled: root.selected >= 0;
                    clicked => { root.action("connect"); }
                }
                ToolButton {
                    icon: IconKind.new-session;
                    clicked => { root.action("new-session"); }
                }
                ToolButton {
                    icon: IconKind.new-folder;
                    clicked => { root.action("new-folder"); }
                }
                ToolButton {
                    icon: IconKind.properties;
                    enabled: root.selected >= 0;
                    clicked => { root.action("edit"); }
                }
                ToolButton {
                    icon: IconKind.delete;
                    enabled: root.selected >= 0;
                    clicked => { root.action("delete"); }
                }
            }
        }
        Rectangle {
            height: 28px;
            CompactInput {
                x: 4px;
                width: parent.width - 8px;
                placeholder: "Filter by name or host";
                edited(text) => { root.filter-changed(text); }
                // Enter connects the selected session, else the first one shown.
                submitted => { root.action("connect-filtered"); }
            }
        }
        if root.rows.length == 0: HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: "No saved sessions. Use the New Session button, or tick \"Save session\" in Quick Connect.";
                wrap: word-wrap;
                color: Theme.text-secondary;
                font-size: 11px;
            }
        }
        // Keyboard: Up/Down select, Enter connects or opens a folder,
        // Left/Right close/open a folder, Delete deletes.
        list-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.selected = max(0, root.selected - 1);
                    root.show-selected();
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.selected = min(root.rows.length - 1, root.selected + 1);
                    root.show-selected();
                    return accept;
                }
                if root.selected >= 0 && root.selected < root.rows.length {
                    if event.text == Key.Return {
                        root.activate(root.selected);
                        return accept;
                    }
                    if event.text == Key.Delete {
                        root.action("delete");
                        return accept;
                    }
                    if event.modifiers.control && (event.text == "x" || event.text == "c") {
                        root.action(event.text == "x" ? "cut" : "copy");
                        return accept;
                    }
                    if event.modifiers.control && event.text == "v" && root.can-paste {
                        root.action("paste");
                        return accept;
                    }
                    if root.rows[root.selected].folder
                        && ((event.text == Key.RightArrow && !root.rows[root.selected].expanded)
                            || (event.text == Key.LeftArrow && root.rows[root.selected].expanded)) {
                        root.toggle(root.selected);
                        return accept;
                    }
                }
                // Anything else is typing meant for the terminal: hand it (and focus) over.
                return root.pass-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)
                    ? EventResult.accept : EventResult.reject;
            }
            session-list := ListView {
                for row[i] in root.rows: Rectangle {
                    height: 21px;
                    background: i == root.selected || row.picked ? Theme.active-row-bg : row-touch.has-hover ? Theme.hover-bg : transparent;
                    row-menu := ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: row.folder ? "Expand / Collapse" : "Connect";
                                activated => { root.activate(i); }
                            }
                            if row.folder: MenuItem {
                                title: "Connect All";
                                activated => { root.action("connect-all"); }
                            }
                            if row.ssh: MenuItem {
                                title: "Connect SFTP Tab";
                                activated => { root.action("connect-sftp"); }
                            }
                            if row.ssh: MenuItem {
                                title: "Connect SFTP GUI Tab";
                                activated => { root.action("connect-sftp-gui"); }
                            }
                            MenuItem {
                                title: "Properties...";
                                enabled: !row.folder;
                                activated => { root.action("edit"); }
                            }
                            MenuItem {
                                title: "Duplicate...";
                                enabled: !row.folder;
                                activated => { root.action("duplicate"); }
                            }
                            MenuItem {
                                title: "Cut";
                                enabled: !row.folder;
                                activated => { root.action("cut"); }
                            }
                            MenuItem {
                                title: "Copy";
                                enabled: !row.folder;
                                activated => { root.action("copy"); }
                            }
                            MenuItem {
                                title: "Paste";
                                enabled: root.can-paste;
                                activated => { root.action("paste"); }
                            }
                            if row.folder: MenuItem {
                                title: "Rename...";
                                activated => { root.action("rename-folder"); }
                            }
                            MenuItem {
                                title: "Delete";
                                activated => { root.action("delete"); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "New Session...";
                                activated => { root.action("new-session"); }
                            }
                            MenuItem {
                                title: "New Folder...";
                                activated => { root.action("new-folder"); }
                            }
                        }
                        row-touch := TouchArea {
                            clicked => {
                                root.selected = i;
                                list-keys.focus();
                            }
                            double-clicked => {
                                root.selected = i;
                                root.activate(i);
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.pick(i, event.modifiers.control);
                                } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    if (!row.picked) {
                                        root.pick(i, false);
                                    }
                                    root.selected = i;
                                    row-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 4px + row.depth * 16px;
                            spacing: 3px;
                            Rectangle {
                                width: 14px;
                                if row.folder: Icon {
                                    y: (parent.height - self.height) / 2;
                                    x: -1px;
                                    kind: row.expanded ? IconKind.chevron-down : IconKind.chevron-right;
                                }
                                TouchArea {
                                    enabled: row.folder;
                                    clicked => {
                                        root.selected = i;
                                        root.toggle(i);
                                    }
                                }
                            }
                            Rectangle {
                                width: 16px;
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    kind: !row.folder ? Icons.protocol-icon(row.protocol) : row.expanded ? IconKind.folder-open : IconKind.folder;
                                }
                            }
                            Text {
                                text: row.label;
                                vertical-alignment: center;
                                overflow: elide;
                                font-size: 12px;
                            }
                            if row.note != "": Text {
                                text: row.note;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                font-size: 11px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }
            }
        }
    }
}

component ActiveSessionsPanel inherits Rectangle {
    in property <[TabData]> tabs;
    in property <int> active-tab;
    // A click (Ctrl+click adds to or takes from the picked tabs).
    callback pick(int, bool);
    // "reconnect", "disconnect" or "close" for the picked tabs.
    callback act(string);
    callback filter-changed(string);
    background: Theme.input-bg;
    VerticalLayout {
        PanelHeader {
            Text {
                x: 6px;
                height: parent.height;
                text: "Active Sessions";
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            padding: 4px;
            CompactInput {
                placeholder: "Filter (Ctrl+click picks several)";
                edited(text) => { root.filter-changed(text); }
            }
        }
        ListView {
            for tab in root.tabs: Rectangle {
                height: 21px;
                background: tab.picked ? Theme.active-row-bg : tab.index == root.active-tab ? Theme.hover-bg : touch.has-hover ? Theme.hover-bg : transparent;
                row-menu := ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Reconnect";
                            activated => { root.act("reconnect"); }
                        }
                        MenuItem {
                            title: "Disconnect";
                            activated => { root.act("disconnect"); }
                        }
                        MenuItem {
                            title: "Lock";
                            activated => { root.act("lock"); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: "Close";
                            activated => { root.act("close"); }
                        }
                    }
                }
                touch := TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.pick(tab.index, event.modifiers.control);
                        } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            if (!tab.picked) {
                                root.pick(tab.index, false);
                            }
                            row-menu.show({ x: self.mouse-x, y: self.mouse-y });
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 5px;
                    Rectangle {
                        width: 16px;
                        SessionIcon {
                            y: (parent.height - self.height) / 2;
                            protocol: tab.protocol;
                            state: tab.state;
                            backdrop: tab.picked ? Theme.active-row-bg : Theme.input-bg;
                        }
                    }
                    Text {
                        text: tab.title;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}

// Saved commands; double-click sends one to the active session.
component CommandManagerPanel inherits Rectangle {
    in property <[CommandRow]> rows;
    // The selected command's index in the saved list.
    in-out property <int> selected: -1;
    callback send(int);
    // index -1 adds a new command.
    callback edit(int);
    callback remove(int);
    callback toggle-folder(string);
    callback to-bar(int);
    callback filter-changed(string);
    background: Theme.input-bg;
    VerticalLayout {
        PanelHeader {
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 2px;
                padding-top: 1px;
                Text {
                    text: "Command Manager";
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                ToolButton {
                    icon: IconKind.connect;
                    enabled: root.selected >= 0;
                    clicked => { root.send(root.selected); }
                }
                ToolButton {
                    icon: IconKind.new-session;
                    clicked => { root.edit(-1); }
                }
                ToolButton {
                    icon: IconKind.properties;
                    enabled: root.selected >= 0;
                    clicked => { root.edit(root.selected); }
                }
                ToolButton {
                    icon: IconKind.delete;
                    enabled: root.selected >= 0;
                    clicked => { root.remove(root.selected); }
                }
            }
        }
        HorizontalLayout {
            padding: 4px;
            CompactInput {
                placeholder: "Filter by name or text";
                edited(text) => { root.filter-changed(text); }
            }
        }
        if root.rows.length == 0: HorizontalLayout {
            padding: 8px;
            Text {
                text: "No commands (or none match). Use the New button to save a command, then double-click it to send it.";
                wrap: word-wrap;
                color: Theme.text-secondary;
                font-size: 11px;
            }
        }
        ListView {
            for row in root.rows: Rectangle {
                height: row.folder ? 24px : 34px;
                // A folder line: click to open or close it.
                if row.folder: Rectangle {
                    background: folder-touch.has-hover ? Theme.hover-bg : transparent;
                    folder-touch := TouchArea {
                        clicked => { root.toggle-folder(row.label); }
                    }
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 4px;
                        Rectangle {
                            width: 14px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                kind: row.expanded ? IconKind.chevron-down : IconKind.chevron-right;
                            }
                        }
                        Rectangle {
                            width: 16px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                kind: IconKind.folder;
                            }
                        }
                        Text {
                            text: row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                }
                if !row.folder: Rectangle {
                    background: row.index == root.selected ? Theme.active-row-bg : row-touch.has-hover ? Theme.hover-bg : transparent;
                    row-menu := ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "Send";
                                activated => { root.send(row.index); }
                            }
                            MenuItem {
                                title: "Edit...";
                                activated => { root.edit(row.index); }
                            }
                            MenuItem {
                                title: "Delete";
                                activated => { root.remove(row.index); }
                            }
                            MenuItem {
                                title: "Copy to Button Bar";
                                activated => { root.to-bar(row.index); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: "New Command...";
                                activated => { root.edit(-1); }
                            }
                        }
                        row-touch := TouchArea {
                            clicked => { root.selected = row.index; }
                            double-clicked => {
                                root.selected = row.index;
                                root.send(row.index);
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.selected = row.index;
                                    row-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                        }
                        VerticalLayout {
                            padding-left: 8px + row.depth * 14px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: row.label;
                                overflow: elide;
                                font-size: 12px;
                            }
                            Text {
                                text: row.text;
                                overflow: elide;
                                font-size: 11px;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                }
            }
        }
    }
}

component SessionTab inherits Rectangle {
    in property <string> title;
    in property <int> protocol;
    in property <int> state;
    in property <color> strip;
    // Shown in its group; `focused` is the one with the keyboard.
    in property <bool> active;
    in property <bool> focused;
    in property <bool> activity;
    in property <bool> scripting;
    in property <bool> locked;
    in property <int> group;
    in property <int> group-count: 1;
    callback select();
    callback close();
    callback action(string);
    // Dragged and let go at this x (in the window): moving it to another place or group.
    callback dropped(length);
    // Where the pointer is (in the window) while this tab is dragged; -1px when let go.
    callback drag-moved(length);
    // The pointer of a tab being dragged, if any. Over this one (or the gap after
    // it), the dragged tab would land on this side of it: -1 before, 1 after, 0 neither.
    in property <length> drag-x: -1px;
    out property <int> drop-side: touch.dragged || self.drag-x < self.absolute-position.x || self.drag-x >= self.absolute-position.x + self.width + 1px ? 0
        : self.drag-x < self.absolute-position.x + self.width / 2 ? -1 : 1;
    height: 24px;
    // Sized to the title; squeezed (title elided) when many tabs are open.
    preferred-width: min(240px, max(100px, label.preferred-width + 52px));
    min-width: 64px;
    max-width: self.preferred-width;
    background: root.active ? Theme.tab-active-bg : touch.has-hover ? Theme.hover-bg : Theme.tab-inactive-bg;
    border-width: 1px;
    border-color: root.active ? Theme.border-strong : Theme.border;
    tab-menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "Reconnect";
                enabled: root.state == 2;
                activated => { root.action("reconnect"); }
            }
            MenuItem {
                title: "Disconnect";
                enabled: root.state != 2;
                activated => { root.action("disconnect"); }
            }
            MenuItem {
                title: "Clone Session";
                activated => { root.action("clone"); }
            }
            if root.protocol == 0: MenuItem {
                title: "Connect SFTP Tab";
                activated => { root.action("sftp"); }
            }
            if root.protocol == 0: MenuItem {
                title: "Connect SFTP GUI Tab";
                activated => { root.action("sftp-gui"); }
            }
            MenuItem {
                title: "Session Options...";
                activated => { root.action("options"); }
            }
            MenuItem {
                title: root.locked ? "Unlock Session..." : "Lock Session...";
                activated => { root.action(root.locked ? "unlock" : "lock"); }
            }
            if !root.locked: MenuItem {
                title: "Lock and Hide Output...";
                activated => { root.action("lock-hide"); }
            }
            MenuItem {
                title: "Rename...";
                activated => { root.action("rename"); }
            }
            MenuItem {
                title: "Move Left";
                activated => { root.action("move-left"); }
            }
            MenuItem {
                title: "Move Right";
                activated => { root.action("move-right"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Move to New Tab Group";
                activated => { root.action("group-new"); }
            }
            MenuItem {
                title: "Move to Previous Tab Group";
                enabled: root.group > 0;
                activated => { root.action("group-prev"); }
            }
            MenuItem {
                title: "Move to Next Tab Group";
                enabled: root.group + 1 < root.group-count;
                activated => { root.action("group-next"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Close";
                activated => { root.close(); }
            }
        }
        touch := TouchArea {
            // Kept by hand: `pressed` is already false when the release arrives.
            property <bool> dragged;
            mouse-cursor: self.dragged ? MouseCursor.grabbing : MouseCursor.default;
            clicked => { root.select(); }
            moved => {
                if self.dragged || abs(self.mouse-x - self.pressed-x) > 20px {
                    self.dragged = true;
                    root.drag-moved(self.absolute-position.x + self.mouse-x);
                }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    tab-menu.show({ x: self.mouse-x, y: self.mouse-y });
                } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                    root.close();
                } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && self.dragged) {
                    self.dragged = false;
                    root.dropped(self.absolute-position.x + self.mouse-x);
                    root.drag-moved(-1px);
                } else if (event.kind == PointerEventKind.cancel) {
                    self.dragged = false;
                    root.drag-moved(-1px);
                }
            }
        }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 3px;
            spacing: 5px;
            Rectangle {
                width: 16px;
                SessionIcon {
                    y: (parent.height - self.height) / 2;
                    protocol: root.protocol;
                    state: root.state;
                    backdrop: root.active ? Theme.tab-active-bg : Theme.tab-inactive-bg;
                }
            }
            if root.scripting || root.locked: Rectangle {
                width: 12px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    size: 12px;
                    kind: root.locked ? IconKind.lock : IconKind.script;
                    ink: Theme.accent;
                }
            }
            label := Text {
                text: root.title;
                vertical-alignment: center;
                overflow: elide;
                font-size: 12px;
                font-weight: root.activity ? 600 : 400;
                color: root.active || root.activity ? Theme.text : Theme.text-secondary;
            }
            if root.activity: Rectangle {
                width: 6px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }
            Rectangle {
                width: 16px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    border-radius: 2px;
                    background: close-touch.has-hover ? Theme.border-strong : transparent;
                    Text {
                        text: "×";
                        font-size: 13px;
                        color: close-touch.has-hover ? Theme.text : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-touch := TouchArea {
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }
    // Session tab colour as a strip along the top edge; with several tab
    // groups the accent marks the group that has the keyboard.
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 3px;
        background: root.focused && root.group-count > 1 ? Theme.accent : root.strip;
    }
    // Where a dragged tab would land: a bar in the gap on that side.
    if root.drop-side != 0: Rectangle {
        x: root.drop-side < 0 ? -2px : root.width - 1px;
        width: 3px;
        background: Theme.accent;
    }
}

// Collapsed dock tab with vertical text, as on the left edge of the main window.
// The label is a pre-rotated image (the software renderer cannot rotate text).
component ScratchpadPanel inherits Rectangle {
    in-out property <string> text;
    in-out property <int> target;
    // Rust selects the line just sent: a new serial applies start..end (byte offsets).
    in property <int> sel-start;
    in property <int> sel-end;
    in property <int> sel-serial;
    // "next" (send the next line), "all", "open", "save".
    callback act(string);
    changed sel-serial => { editor.set-selection-offsets(root.sel-start, root.sel-end); }
    background: Theme.input-bg;
    VerticalLayout {
        PanelHeader {
            Text {
                x: 6px;
                height: parent.height;
                text: "Scratchpad";
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            padding: 4px;
            spacing: 6px;
            Text {
                text: "Send to";
                font-size: 11px;
                vertical-alignment: center;
            }
            ComboBox {
                model: ["the active tab", "all tabs", "tabs on screen"];
                current-index <=> root.target;
            }
        }
        editor := TextEdit {
            vertical-stretch: 1;
            text <=> root.text;
            font-family: "IBM Plex Mono";
            font-size: 12px;
            placeholder-text: "Commands to send, one per line";
        }
        HorizontalLayout {
            padding: 4px;
            spacing: 4px;
            Button {
                text: "Send Next Line";
                clicked => { root.act("next"); }
            }
            Button {
                text: "Send All";
                clicked => { root.act("all"); }
            }
        }
        HorizontalLayout {
            padding: 4px;
            padding-top: 0px;
            spacing: 4px;
            Button {
                text: "Open...";
                clicked => { root.act("open"); }
            }
            Button {
                text: "Save...";
                clicked => { root.act("save"); }
            }
        }
    }
}

component DockTab inherits Rectangle {
    in property <image> label;
    in property <bool> active;
    callback clicked;
    width: 20px;
    height: label-image.height + 16px;
    background: root.active ? Theme.panel-bg : touch.has-hover ? Theme.hover-bg : Theme.sidebar-bg;
    border-width: 1px;
    border-color: Theme.border;
    label-image := Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.label.width * 1phx;
        height: root.label.height * 1phx;
        source: root.label;
        colorize: Theme.text;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TermScrollBar inherits Rectangle {
    in property <int> offset;
    in property <int> history;
    in property <int> rows;
    // 0 = oldest history line at the top, 1 = live screen.
    callback set-fraction(float);
    width: 16px;
    background: Theme.toolbar-bg;
    property <length> thumb-h: root.history == 0 ? root.height : max(24px, root.height * root.rows / (root.rows + root.history));
    property <length> travel: root.height - thumb-h;
    property <float> grab: 0;
    Rectangle {
        x: 3px;
        y: root.history == 0 ? 0px : root.travel * (1 - root.offset / root.history);
        width: parent.width - 6px;
        height: root.thumb-h;
        border-radius: 4px;
        visible: root.history > 0;
        background: touch.pressed ? Theme.text-secondary : touch.has-hover ? Theme.text-disabled : Theme.scrollbar;
    }
    touch := TouchArea {
        function jump() {
            if (root.history > 0 && root.travel > 0) {
                root.set-fraction(max(0, min(1, (self.mouse-y - root.thumb-h / 2) / root.travel)));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.jump();
            }
        }
        moved => { self.jump(); }
    }
}

// One Button Bar button; right-click to edit or delete it.
component BarButtonView inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    callback clicked();
    callback edit();
    callback remove();
    height: 22px;
    width: max(44px, caption.preferred-width + 18px);
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.active-row-bg : touch.has-hover ? Theme.hover-bg : Theme.panel-bg;
    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "Edit Button...";
                activated => { root.edit(); }
            }
            MenuItem {
                title: "Delete Button";
                activated => { root.remove(); }
            }
        }
        touch := TouchArea {
            clicked => { root.clicked(); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
        caption := Text {
            x: 9px;
            height: parent.height;
            text: root.label;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    // The button's colour, as a strip on its left edge.
    Rectangle {
        x: 1px;
        y: 1px;
        width: 4px;
        height: parent.height - 2px;
        border-radius: 2px;
        background: root.tint;
    }
}

component StatusCell inherits Rectangle {
    in property <string> text;
    in property <length> min-cell-width: 40px;
    in property <bool> dim: false;
    min-width: max(root.min-cell-width, t.preferred-width + 14px);
    horizontal-stretch: 0;
    Rectangle {
        x: 0px;
        y: 3px;
        width: 1px;
        height: parent.height - 6px;
        background: Theme.border;
    }
    t := Text {
        x: 7px;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        color: root.dim ? Theme.text-disabled : Theme.text;
        vertical-alignment: center;
    }
}

// Full-window dimmer plus a centred dialog box; children form the dialog body.
component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 440px;
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: #00000040;
    // Moved by dragging the title bar; kept inside the window.
    property <length> offset-x;
    property <length> offset-y;
    TouchArea { }
    frame := Rectangle {
        x: max(0px, (parent.width - self.width) / 2 + root.offset-x);
        y: max(0px, (parent.height - self.height) / 2 + root.offset-y);
        width: root.dialog-width;
        height: body.preferred-height;
        background: Theme.panel-bg;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000055;
        body := VerticalLayout {
            Rectangle {
                height: 32px;
                background: Theme.window-bg;
                border-radius: 6px;
                Text {
                    x: 14px;
                    height: parent.height;
                    text: root.title;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                TouchArea {
                    moved => {
                        // The title bar moves with the frame, so the pointer stays at pressed-x/y.
                        let room-x = max(0px, (root.width - frame.width) / 2);
                        let room-y = max(0px, (root.height - frame.height) / 2);
                        root.offset-x = clamp(root.offset-x + self.mouse-x - self.pressed-x, -room-x, room-x);
                        root.offset-y = clamp(root.offset-y + self.mouse-y - self.pressed-y, -room-y, room-y);
                    }
                }
            }
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                @children
            }
        }
    }
}

component DialogButtons inherits HorizontalLayout {
    alignment: end;
    spacing: 8px;
}

component HostKeyDialog inherits DialogFrame {
    in property <string> host;
    in property <string> key-type;
    in property <string> fingerprint;
    // 0 accept and save, 1 accept once, 2 cancel
    callback answer(int);
    title: "New Host Key";
    dialog-width: 520px;
    Text {
        text: "OpenCRT has no stored host key for " + root.host + ". Before accepting it, confirm the fingerprint below with the server's administrator.";
        wrap: word-wrap;
    }
    GridLayout {
        spacing-horizontal: 12px;
        spacing-vertical: 6px;
        Row {
            Text { text: "Key type:"; color: Theme.text-secondary; }
            Text { text: root.key-type; font-family: "Consolas"; }
        }
        Row {
            Text { text: "Fingerprint:"; color: Theme.text-secondary; }
            // char-wrap: a certificate's colon hex has no spaces to break at.
            TextInput { text: root.fingerprint; read-only: true; font-family: "Consolas"; wrap: char-wrap; }
        }
    }
    DialogButtons {
        Button {
            text: "Accept & Save";
            primary: true;
            clicked => { root.answer(0); }
        }
        Button {
            text: "Accept Once";
            clicked => { root.answer(1); }
        }
        Button {
            text: "Cancel";
            clicked => { root.answer(2); }
        }
    }
}

component AuthDialog inherits DialogFrame {
    in property <string> instructions;
    in property <[PromptField]> fields;
    in-out property <[string]> answers;
    // Offer "Save password" (a login password for a saved session).
    in property <bool> can-save;
    in-out property <bool> save;
    // "Type the password" then the saved credentials, for a password prompt.
    in property <[string]> credentials;
    in-out property <int> credential;
    in property <string> error;
    callback answer(bool);
    dialog-width: 460px;
    if root.instructions != "": Text {
        text: root.instructions;
        wrap: word-wrap;
    }
    if root.credentials.length > 1: HorizontalLayout {
        spacing: 10px;
        Text {
            width: 150px;
            text: "Use credential:";
            vertical-alignment: center;
        }
        ComboBox {
            model: root.credentials;
            current-index <=> root.credential;
        }
    }
    for field[i] in root.credential == 0 ? root.fields : []: HorizontalLayout {
        spacing: 10px;
        Text {
            width: 150px;
            text: field.label;
            vertical-alignment: center;
            overflow: elide;
        }
        LineEdit {
            input-type: field.echo ? InputType.text : InputType.password;
            edited(text) => { root.answers[i] = text; }
            accepted => { root.answer(true); }
            init => {
                if (i == 0) {
                    self.focus();
                }
            }
        }
    }
    if root.can-save: CheckBox {
        text: root.credential > 0 ? "Use this credential for the session from now on" : "Save password (in the system keychain, once the login works)";
        checked <=> root.save;
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.status-error;
        wrap: word-wrap;
    }
    DialogButtons {
        Button {
            text: "OK";
            primary: true;
            clicked => { root.answer(true); }
        }
        Button {
            text: "Cancel";
            clicked => { root.answer(false); }
        }
    }
}


component FormLabel inherits Text {
    vertical-alignment: center;
    color: Theme.text;
}

component TableCell inherits Text {
    vertical-alignment: center;
    overflow: elide;
    font-size: 12px;
}

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    FormLabel {
        width: 120px;
        text: root.label;
    }
    @children
}

// Protocol-dependent connection fields, shared by Quick Connect and Session
// Options. Protocol indexes follow config::Protocol::ALL.
component ConnectionFields inherits VerticalLayout {
    in-out property <int> protocol;
    in-out property <string> host;
    in-out property <string> port;
    in-out property <string> user;
    in-out property <string> key-file;
    in-out property <string> serial-port;
    in-out property <string> baud;
    in-out property <int> line-data;
    in-out property <int> line-parity;
    in-out property <int> line-stop;
    in-out property <int> line-flow;
    in property <[string]> serial-ports;
    in property <bool> show-key: true;
    in property <bool> focus-host: false;
    callback submit();
    callback browse-key();
    spacing: 8px;
    FieldRow {
        label: "Protocol:";
        ComboBox {
            model: ["SSH2", "Telnet", "Raw", "Serial", "Local Shell", "RDP", "RLogin"];
            current-index <=> root.protocol;
            selected => {
                // Follow the protocol's default port unless one was typed.
                if (root.port == "" || root.port == "22" || root.port == "23" || root.port == "3389" || root.port == "513") {
                    root.port = root.protocol == 0 ? "22" : root.protocol == 5 ? "3389" : root.protocol == 6 ? "513" : "23";
                }
            }
        }
    }
    if root.protocol <= 2 || root.protocol >= 5: FieldRow {
        label: "Hostname:";
        LineEdit {
            text <=> root.host;
            accepted => { root.submit(); }
            init => {
                if (root.focus-host) {
                    self.focus();
                }
            }
        }
    }
    if root.protocol <= 2 || root.protocol >= 5: FieldRow {
        label: "Port:";
        LineEdit {
            text <=> root.port;
            accepted => { root.submit(); }
        }
    }
    if root.protocol == 0 || root.protocol >= 5: FieldRow {
        label: "Username:";
        LineEdit {
            text <=> root.user;
            // RDP accepts a Windows domain this way.
            placeholder-text: root.protocol == 5 ? "user, DOMAIN\\user or user@domain" : "";
            accepted => { root.submit(); }
        }
    }
    if root.protocol == 0 && root.show-key: FieldRow {
        label: "Private key:";
        LineEdit {
            text <=> root.key-file;
            placeholder-text: "optional, path to key file";
            accepted => { root.submit(); }
        }
        Button {
            text: "...";
            clicked => { root.browse-key(); }
        }
    }
    if root.protocol == 3: FieldRow {
        label: "Port name:";
        LineEdit {
            text <=> root.serial-port;
            placeholder-text: "e.g. COM3 or /dev/ttyUSB0";
            accepted => { root.submit(); }
        }
    }
    if root.protocol == 3 && root.serial-ports.length > 0: FieldRow {
        label: "Detected:";
        ComboBox {
            model: root.serial-ports;
            selected(value) => { root.serial-port = value; }
        }
    }
    if root.protocol == 3: FieldRow {
        label: "Baud rate:";
        LineEdit {
            text <=> root.baud;
            accepted => { root.submit(); }
        }
    }
    if root.protocol == 3: FieldRow {
        label: "Data bits:";
        ComboBox {
            model: ["8", "7", "6", "5"];
            current-index <=> root.line-data;
        }
    }
    if root.protocol == 3: FieldRow {
        label: "Parity:";
        ComboBox {
            model: ["None", "Odd", "Even"];
            current-index <=> root.line-parity;
        }
    }
    if root.protocol == 3: FieldRow {
        label: "Stop bits:";
        ComboBox {
            model: ["1", "2"];
            current-index <=> root.line-stop;
        }
    }
    if root.protocol == 3: FieldRow {
        label: "Flow control:";
        ComboBox {
            model: ["None", "XON/XOFF", "RTS/CTS"];
            current-index <=> root.line-flow;
        }
    }
    if root.protocol == 4: Text {
        text: "Opens your default shell (PowerShell on Windows, $SHELL elsewhere).";
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

component QuickConnectDialog inherits DialogFrame {
    in-out property <int> protocol;
    in-out property <int> line-data;
    in-out property <int> line-parity;
    in-out property <int> line-stop;
    in-out property <int> line-flow;
    in-out property <string> host;
    in-out property <string> port;
    in-out property <string> user;
    in-out property <string> key-file;
    in-out property <string> serial-port;
    in-out property <string> baud;
    in property <[string]> serial-ports;
    in-out property <bool> save-session;
    in property <string> error;
    callback connect();
    callback cancel();
    // Which field to fill from a file dialog: "qc-key".
    callback browse(string);
    title: "Quick Connect";
    dialog-width: 460px;
    ConnectionFields {
        protocol <=> root.protocol;
        host <=> root.host;
        port <=> root.port;
        user <=> root.user;
        key-file <=> root.key-file;
        serial-port <=> root.serial-port;
        baud <=> root.baud;
        line-data <=> root.line-data;
        line-parity <=> root.line-parity;
        line-stop <=> root.line-stop;
        line-flow <=> root.line-flow;
        serial-ports: root.serial-ports;
        focus-host: true;
        submit => { root.connect(); }
        browse-key => { root.browse("qc-key"); }
    }
    CheckBox {
        text: "Save session";
        checked <=> root.save-session;
    }
    if root.protocol == 0: Text {
        text: "Passwords and passphrases are asked for when the server needs them.";
        color: Theme.text-secondary;
        font-size: 11px;
        wrap: word-wrap;
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.status-error;
    }
    DialogButtons {
        Button {
            text: "Connect";
            primary: true;
            clicked => { root.connect(); }
        }
        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
    }
}

component SessionOptionsDialog inherits DialogFrame {
    in-out property <int> category: 0;
    in-out property <int> line-data;
    in-out property <int> line-parity;
    in-out property <int> line-stop;
    in-out property <int> line-flow;
    in-out property <string> name;
    in-out property <string> folder;
    in-out property <int> protocol;
    in-out property <string> serial-port;
    in-out property <string> baud;
    in property <[string]> serial-ports;
    in-out property <string> host;
    in-out property <string> port;
    in-out property <string> user;
    in-out property <string> key-file;
    in-out property <string> cert-file;
    in-out property <string> log-file;
    in-out property <string> logon-script;
    in-out property <string> logon-text;
    in-out property <string> jump-host;
    in-out property <string> remote-command;
    in-out property <string> notes;
    in-out property <bool> sftp;
    in-out property <string> dial-number;
    in-out property <string> modem-init;
    in-out property <bool> tls;
    in-out property <string> pre-connect;
    in-out property <string> proxy;
    // Editing the Default Session (Options > Default Session).
    in property <bool> template;
    // 0 none, then the palette in app.rs TAB_COLORS
    in-out property <int> tab-color;
    in-out property <bool> backspace-ctrl-h;
    in-out property <int> emulation;
    in-out property <string> key-map;
    in-out property <string> button-bar;
    in-out property <string> columns;
    in-out property <string> rows;
    in-out property <bool> deccolm;
    in-out property <string> rdp-width;
    in-out property <string> rdp-height;
    in-out property <bool> rdp-scale;
    in-out property <int> rdp-speed;
    in-out property <bool> rdp-sound;
    in-out property <string> rdp-share;
    in-out property <bool> rdp-h264;
    in-out property <string> terminal-type;
    // Index into codec::ENCODINGS.
    in-out property <int> encoding;
    in property <[string]> encoding-names;
    in-out property <bool> legacy;
    in-out property <bool> compression;
    in-out property <bool> forward-agent;
    in-out property <bool> forward-x11;
    in-out property <bool> log-timestamps;
    in-out property <string> log-connect;
    in-out property <string> log-disconnect;
    in-out property <string> log-line;
    in-out property <string> anti-idle;
    in-out property <string> anti-idle-secs;
    in-out property <bool> anti-idle-protocol;
    // "None" then the saved credentials' names.
    in property <[string]> credential-choices;
    in-out property <int> credential;
    in property <[ForwardRow]> forward-rows;
    in-out property <int> forward-selected: -1;
    // index -1 adds a new forward.
    callback forward-edit(int);
    callback forward-remove(int);
    in-out property <int> scheme-index;
    in property <[string]> scheme-choices;
    // "Default" then the named keyword sets.
    in property <[string]> keyword-set-choices;
    in-out property <int> keyword-set;
    in property <string> error;
    callback ok();
    callback cancel();
    // Which field to fill from a file dialog: "so-key", "so-log" or "so-script".
    callback browse(string);
    // Editing this many sessions at once (only the changed options apply to all).
    in property <int> many;
    // RDP has no terminal: its sessions skip the terminal pages (Terminal, Log
    // File, Port Forwarding, Logon Script, Keyboard); others skip Remote Desktop.
    pure function page-applies(page: int) -> bool {
        root.protocol == 5 ? page == 0 || page == 1 || page == 3 || page == 8 : page != 8
    }
    changed protocol => {
        if !root.page-applies(root.category) {
            root.category = 0;
        }
    }
    title: root.many > 1 ? "Session Options (\{root.many} sessions)" : "Session Options";
    dialog-width: 640px;
    HorizontalLayout {
        spacing: 14px;
        height: 330px;
        Rectangle {
            width: 150px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 2px;
                alignment: start;
                for page[i] in ["Connection", "Authentication", "Terminal", "Appearance", "Log File", "Port Forwarding", "Logon Script", "Keyboard", "Remote Desktop"]: Rectangle {
                    visible: root.page-applies(i);
                    height: self.visible ? 24px : 0px;
                    background: i == root.category ? Theme.active-row-bg : page-touch.has-hover ? Theme.hover-bg : transparent;
                    Text {
                        x: 8px;
                        height: parent.height;
                        text: page;
                        vertical-alignment: center;
                    }
                    page-touch := TouchArea {
                        clicked => { root.category = i; }
                    }
                }
            }
        }
        ScrollView {
            content-width: self.visible-width;
            VerticalLayout {
                spacing: 10px;
                alignment: start;
                padding-right: 14px;
                if root.category == 0: VerticalLayout {
                    spacing: 8px;
                    FieldRow {
                        label: "Session name:";
                        LineEdit {
                            text <=> root.name;
                            // The Default Session is a template: no name or folder of its own.
                            enabled: !root.template && root.many <= 1;
                        }
                    }
                    FieldRow {
                        label: "Folder:";
                        LineEdit {
                            text <=> root.folder;
                            enabled: !root.template && root.many <= 1;
                            placeholder-text: "e.g. Production/Web (blank for top level)";
                        }
                    }
                    ConnectionFields {
                        protocol <=> root.protocol;
                        host <=> root.host;
                        port <=> root.port;
                        user <=> root.user;
                        key-file <=> root.key-file;
                        serial-port <=> root.serial-port;
                        baud <=> root.baud;
                        line-data <=> root.line-data;
                        line-parity <=> root.line-parity;
                        line-stop <=> root.line-stop;
                        line-flow <=> root.line-flow;
                        serial-ports: root.serial-ports;
                        show-key: false;
                        submit => { root.ok(); }
                    }
                    if root.protocol == 3: FieldRow {
                        label: "Dial number:";
                        LineEdit {
                            text <=> root.dial-number;
                            placeholder-text: "blank for a direct line; a number, or a dial command such as ATDP123";
                            accepted => { root.ok(); }
                        }
                    }
                    if root.protocol == 3: FieldRow {
                        label: "Modem init:";
                        LineEdit {
                            text <=> root.modem-init;
                            enabled: root.dial-number != "";
                            placeholder-text: "ATZ";
                            accepted => { root.ok(); }
                        }
                    }
                    if root.protocol == 0: FieldRow {
                        label: "Jump host:";
                        LineEdit {
                            text <=> root.jump-host;
                            placeholder-text: "optional, [user@]host[:port] to connect through";
                            accepted => { root.ok(); }
                        }
                    }
                    if root.protocol != 4: FieldRow {
                        label: "Before connecting:";
                        LineEdit {
                            text <=> root.pre-connect;
                            placeholder-text: "optional local command, e.g. port knocking (must finish within 60 s)";
                            accepted => { root.ok(); }
                        }
                    }
                    if root.protocol == 0: FieldRow {
                        label: "Remote command:";
                        LineEdit {
                            text <=> root.remote-command;
                            enabled: !root.sftp;
                            placeholder-text: "optional, run instead of the login shell";
                            accepted => { root.ok(); }
                        }
                    }
                    if root.protocol == 0: FieldRow {
                        label: "";
                        CheckBox {
                            text: "Open as an SFTP tab (file transfer commands, no shell)";
                            checked <=> root.sftp;
                        }
                    }
                    if root.protocol == 1: FieldRow {
                        label: "";
                        CheckBox {
                            text: "Encrypt with TLS (Telnet/TLS, usually port 992)";
                            checked <=> root.tls;
                        }
                    }
                    if root.protocol <= 2 || root.protocol == 6: FieldRow {
                        label: "Proxy:";
                        LineEdit {
                            text <=> root.proxy;
                            placeholder-text: "optional: a firewall name (Options > Firewalls) or socks5:// socks4:// http://host[:port]";
                            accepted => { root.ok(); }
                        }
                    }
                    FieldRow {
                        label: "Notes:";
                        TextEdit {
                            height: 60px;
                            text <=> root.notes;
                            wrap: word-wrap;
                            placeholder-text: "optional; the first line shows in the Session Manager";
                        }
                    }
                }
                if root.category == 1: VerticalLayout {
                    spacing: 8px;
                    FieldRow {
                        label: "Credential:";
                        ComboBox {
                            model: root.credential-choices;
                            current-index <=> root.credential;
                            // SSH2, Telnet and RDP (see config::Protocol::ALL).
                            enabled: root.protocol == 0 || root.protocol == 1 || root.protocol == 5;
                        }
                    }
                    if root.credential-choices.length <= 1: Text {
                        text: "No saved credentials yet. Tick \"Save password\" when you are asked for the password, or create one in Tools > Credentials Manager.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                    if root.credential > 0: Text {
                        text: root.protocol == 1
                            ? "OpenCRT answers the host's first login and password prompts with this credential, unless you start typing first. Manage credentials in Tools > Credentials Manager."
                            : "The username (if the credential has one) and the saved password come from this credential. Manage credentials in Tools > Credentials Manager.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                    FieldRow {
                        label: "Private key file:";
                        LineEdit {
                            text <=> root.key-file;
                            placeholder-text: "blank to use password authentication";
                        }
                        Button {
                            text: "...";
                            clicked => { root.browse("so-key"); }
                        }
                    }
                    FieldRow {
                        label: "Certificate:";
                        LineEdit {
                            text <=> root.cert-file;
                            enabled: root.protocol == 0 && root.key-file != "";
                            placeholder-text: "optional; <key file>-cert.pub is used if it exists";
                        }
                        Button {
                            text: "...";
                            enabled: root.protocol == 0 && root.key-file != "";
                            clicked => { root.browse("so-cert"); }
                        }
                    }
                    CheckBox {
                        text: "Allow legacy algorithms (SHA-1 key exchange, CBC ciphers) for old devices";
                        checked <=> root.legacy;
                        enabled: root.protocol == 0;
                    }
                    CheckBox {
                        text: "Enable compression (for slow links)";
                        checked <=> root.compression;
                        enabled: root.protocol == 0;
                    }
                    CheckBox {
                        text: "Forward the SSH agent (only to hosts you trust)";
                        checked <=> root.forward-agent;
                        enabled: root.protocol == 0;
                    }
                    Text {
                        text: "Order tried: public key (the key file if set, otherwise keys in a running SSH agent such as Pageant), then keyboard-interactive or password. Passwords are only saved in a credential, in the system keychain; otherwise you are asked for them when needed.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                }
                if root.category == 2: GridLayout {
                    spacing-horizontal: 10px;
                    spacing-vertical: 8px;
                    Row {
                        FormLabel { text: "Emulation:"; }
                        ComboBox {
                            model: ["Xterm", "VT100", "VT102", "VT220", "VT320", "ANSI", "Linux console"];
                            current-index <=> root.emulation;
                        }
                    }
                    Row {
                        FormLabel { text: "Terminal type:"; }
                        LineEdit {
                            text <=> root.terminal-type;
                            placeholder-text: "blank for the emulation's (xterm-256color, vt100...)";
                        }
                    }
                    Row {
                        FormLabel { text: "Size:"; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            LineEdit {
                                width: 72px;
                                text <=> root.columns;
                                placeholder-text: "cols";
                            }
                            FormLabel { text: "×"; }
                            LineEdit {
                                width: 72px;
                                text <=> root.rows;
                                placeholder-text: "rows";
                            }
                            FormLabel { text: "blank fits the window"; color: Theme.text-secondary; font-size: 11px; }
                        }
                    }
                    Row {
                        FormLabel { text: ""; }
                        CheckBox {
                            text: "Let the host switch between 80 and 132 columns";
                            checked <=> root.deccolm;
                        }
                    }
                    Row {
                        FormLabel { text: "Scrollback:"; }
                        FormLabel { text: "Set in Options > Global Options."; color: Theme.text-secondary; }
                    }
                    Row {
                        FormLabel { text: "Character encoding:"; }
                        ComboBox {
                            model: root.encoding-names;
                            current-index <=> root.encoding;
                        }
                    }
                    Row {
                        FormLabel { text: "Backspace:"; }
                        CheckBox {
                            text: "Sends Ctrl+H (^H) instead of DEL";
                            checked <=> root.backspace-ctrl-h;
                        }
                    }
                    Row {
                        FormLabel { text: "Anti-idle text:"; }
                        LineEdit {
                            text <=> root.anti-idle;
                            enabled: !root.anti-idle-protocol;
                            placeholder-text: "e.g. \\r, sent when no key is pressed for a while";
                        }
                    }
                    Row {
                        Rectangle { }
                        CheckBox {
                            text: "Send an SSH keepalive or Telnet NOP instead of text";
                            checked <=> root.anti-idle-protocol;
                        }
                    }
                    Row {
                        FormLabel { text: "Anti-idle every:"; }
                        LineEdit {
                            text <=> root.anti-idle-secs;
                            placeholder-text: "seconds (blank for off)";
                        }
                    }
                }
                if root.category == 3: GridLayout {
                    spacing-horizontal: 10px;
                    Row {
                        FormLabel { text: "Colour scheme:"; }
                        ComboBox {
                            model: root.scheme-choices;
                            current-index <=> root.scheme-index;
                        }
                    }
                    Row {
                        FormLabel { text: "Keyword set:"; }
                        ComboBox {
                            model: root.keyword-set-choices;
                            current-index <=> root.keyword-set;
                        }
                    }
                    Row {
                        FormLabel { text: "Tab colour:"; }
                        ComboBox {
                            model: ["None", "Red", "Orange", "Yellow", "Green", "Blue", "Purple"];
                            current-index <=> root.tab-color;
                        }
                    }
                    Row {
                        FormLabel { text: "Button bar:"; }
                        LineEdit {
                            text <=> root.button-bar;
                            placeholder-text: "a named Button Bar; blank for the default bar";
                        }
                    }
                }
                if root.category == 4: VerticalLayout {
                    spacing: 8px;
                    FieldRow {
                        label: "Log file name:";
                        LineEdit {
                            text <=> root.log-file;
                            placeholder-text: "blank for no logging";
                        }
                        Button {
                            text: "...";
                            clicked => { root.browse("so-log"); }
                        }
                    }
                    CheckBox {
                        text: "Start each line with the date and time";
                        checked <=> root.log-timestamps;
                    }
                    FieldRow {
                        label: "On connect:";
                        LineEdit {
                            text <=> root.log-connect;
                            placeholder-text: "e.g. === %S connected %Y-%M-%D %h:%m:%s ===";
                        }
                    }
                    FieldRow {
                        label: "On disconnect:";
                        LineEdit { text <=> root.log-disconnect; }
                    }
                    FieldRow {
                        label: "Each line:";
                        LineEdit {
                            text <=> root.log-line;
                            placeholder-text: "e.g. %H: ";
                        }
                    }
                    Text {
                        text: "Session output is appended as plain text while connected. %S expands to the session name, %H to the hostname, %Y %M %D to the date and %h %m %s to the time (of connecting, in the file name; of writing, in the texts above). A log named with the date starts a new file at midnight.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                }
                if root.category == 8: VerticalLayout {
                    spacing: 8px;
                    if root.protocol != 5: Text {
                        text: "These settings are for RDP sessions.";
                        color: Theme.text-secondary;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        FormLabel { text: "Desktop size:"; }
                        LineEdit {
                            text <=> root.rdp-width;
                            enabled: root.protocol == 5;
                            placeholder-text: "width";
                            input-type: number;
                        }
                        Text {
                            text: "x";
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.rdp-height;
                            enabled: root.protocol == 5;
                            placeholder-text: "height";
                            input-type: number;
                        }
                    }
                    CheckBox {
                        text: "Scale to window";
                        checked <=> root.rdp-scale;
                        enabled: root.protocol == 5 && root.rdp-width != "" && root.rdp-height != "";
                    }
                    Text {
                        text: "Blank: the remote desktop follows the tab's size. A fixed size (in pixels) stays the same whatever the window does: shown whole, scaled down when the tab is smaller, or with Scale to window stretched to fill the tab.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        FormLabel { text: "Connection speed:"; }
                        ComboBox {
                            model: ["Best appearance (fast network)", "Balanced: no wallpaper or animations", "Fastest: no visual effects (slow links)"];
                            current-index <=> root.rdp-speed;
                            enabled: root.protocol == 5;
                        }
                    }
                    Text {
                        text: "The less the server draws, the less it sends: leaving out the wallpaper and animations makes the desktop noticeably quicker over the internet or a VPN.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                    CheckBox {
                        text: "Use H.264 when the server offers it (much faster; turn off if the desktop stays black)";
                        checked <=> root.rdp-h264;
                        enabled: root.protocol == 5;
                    }
                    CheckBox {
                        text: "Play the remote computer's sound on this computer";
                        checked <=> root.rdp-sound;
                        enabled: root.protocol == 5;
                    }
                    FieldRow {
                        label: "Share a local folder:";
                        LineEdit {
                            text <=> root.rdp-share;
                            enabled: root.protocol == 5;
                            placeholder-text: "none";
                        }
                        Button {
                            text: "...";
                            enabled: root.protocol == 5;
                            clicked => { root.browse("so-rdp-share"); }
                        }
                    }
                    Text {
                        text: "The folder appears on the remote computer as a drive (under This PC), named after the folder: copy files to and from it there. The remote computer can read, change and delete everything in it.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                }
                if root.category == 7: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Keys mapped for this session (tried before Global Options > Keyboard), one per line:";
                        wrap: word-wrap;
                    }
                    TextEdit {
                        text <=> root.key-map;
                        height: 170px;
                        font-size: 12px;
                    }
                    Text {
                        text: "Key = what it does. Keys: F1-F24, Up, Home, PageUp, Insert, Delete, Tab, Enter, Escape, Space or a character, with Ctrl+ Alt+ Shift+ (characters need Ctrl or Alt). Text is sent (\\r is Enter); or script: file, menu: command, run: program, telnet: brk|ayt|ip|ao|ec|el|ga|nop.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                }
                if root.category == 6: VerticalLayout {
                    spacing: 8px;
                    FieldRow {
                        label: "Script file:";
                        LineEdit {
                            text <=> root.logon-script;
                            placeholder-text: "blank for none";
                        }
                        Button {
                            text: "...";
                            clicked => { root.browse("so-script"); }
                        }
                    }
                    Text {
                        text: "Or write the script here (used when no file is set):";
                    }
                    TextEdit {
                        text <=> root.logon-text;
                        height: 120px;
                        font-size: 12px;
                    }
                    Text {
                        text: "Runs each time the session connects. A .rhai file runs as a Rhai script (see the README). Otherwise one command per line: wait <text> (for the host to print it), send <text> (\\r is Enter), sleep <ms>, timeout <s> (for later waits; default 30), # comment.";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                }
                if root.category == 5: VerticalLayout {
                    spacing: 8px;
                    CheckBox {
                        text: "Forward X11 to the local X server";
                        checked <=> root.forward-x11;
                        enabled: root.protocol == 0;
                    }
                    Text {
                        text: "Uses $DISPLAY, else display 0 on this machine. The X server must accept clients without its own cookie (e.g. VcXsrv with access control disabled).";
                        wrap: word-wrap;
                        color: Theme.text-secondary;
                        font-size: 11px;
                    }
                    Text {
                        text: "Port forwards (SSH2 only):";
                    }
                    Rectangle {
                        height: 150px;
                        background: Theme.input-bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 1px;
                            Rectangle {
                                height: 22px;
                                background: Theme.toolbar-bg;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    spacing: 6px;
                                    TableCell { text: "Name"; width: 96px; color: Theme.text-secondary; }
                                    TableCell { text: "Type"; width: 48px; color: Theme.text-secondary; }
                                    TableCell { text: "Listen"; width: 96px; color: Theme.text-secondary; }
                                    TableCell { text: "Destination"; horizontal-stretch: 1; preferred-width: 10px; color: Theme.text-secondary; }
                                    TableCell { text: "Application"; width: 70px; color: Theme.text-secondary; }
                                }
                            }
                            ListView {
                                for row[i] in root.forward-rows: Rectangle {
                                    height: 21px;
                                    background: i == root.forward-selected ? Theme.active-row-bg : row-touch.has-hover ? Theme.hover-bg : transparent;
                                    row-touch := TouchArea {
                                        clicked => { root.forward-selected = i; }
                                        double-clicked => {
                                            root.forward-selected = i;
                                            root.forward-edit(i);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 6px;
                                        TableCell { text: row.name; width: 96px; color: row.enabled ? Theme.text : Theme.text-disabled; }
                                        TableCell { text: row.kind; width: 48px; color: row.enabled ? Theme.text : Theme.text-disabled; }
                                        TableCell { text: row.listen; width: 96px; color: row.enabled ? Theme.text : Theme.text-disabled; }
                                        TableCell { text: row.dest; horizontal-stretch: 1; preferred-width: 10px; color: row.enabled ? Theme.text : Theme.text-disabled; }
                                        TableCell { text: row.app; width: 70px; color: row.enabled ? Theme.text : Theme.text-disabled; }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button {
                            text: "Add...";
                            enabled: root.protocol == 0;
                            clicked => { root.forward-edit(-1); }
                        }
                        Button {
                            text: "Edit...";
                            enabled: root.forward-selected >= 0 && root.forward-selected < root.forward-rows.length;
                            clicked => { root.forward-edit(root.forward-selected); }
                        }
                        Button {
                            text: "Remove";
                            enabled: root.forward-selected >= 0 && root.forward-selected < root.forward-rows.length;
                            clicked => { root.forward-remove(root.forward-selected); }
                        }
                    }
                }
            }
        }
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.status-error;
        wrap: word-wrap;
    }
    DialogButtons {
        Button {
            text: "OK";
            primary: true;
            clicked => { root.ok(); }
        }
        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
    }
}

component ForwardDialog inherits DialogFrame {
    in-out property <string> name;
    // 0 local, 1 remote, 2 dynamic (SOCKS)
    in-out property <int> kind;
    in-out property <bool> custom-bind;
    in-out property <string> bind;
    in-out property <string> port;
    in-out property <bool> custom-host;
    in-out property <string> host;
    in-out property <string> host-port;
    in-out property <string> application;
    in-out property <string> arguments;
    in-out property <bool> enabled;
    in-out property <string> allow;
    in property <string> error;
    callback ok();
    callback cancel();
    callback browse(string);
    title: "Port Forward Properties";
    dialog-width: 500px;
    FieldRow {
        label: "Name:";
        LineEdit {
            text <=> root.name;
            placeholder-text: "a descriptive name for this forward";
            accepted => { root.ok(); }
        }
    }
    FieldRow {
        label: "Type:";
        ComboBox {
            model: ["Local - a port on this machine", "Remote - a port on the server", "Dynamic - SOCKS 4/5 proxy on this machine"];
            current-index <=> root.kind;
        }
    }
    Text { text: "Listen"; font-weight: 600; }
    CheckBox {
        text: root.kind == 1 ? "Manually select the address the server listens on" : "Manually select the local IP address to listen on";
        checked <=> root.custom-bind;
    }
    FieldRow {
        label: "IP address:";
        LineEdit {
            text <=> root.bind;
            enabled: root.custom-bind;
            placeholder-text: root.kind == 1 ? "e.g. 0.0.0.0 (the server must allow it)" : "e.g. 0.0.0.0 for every interface";
        }
    }
    FieldRow {
        label: "Port:";
        LineEdit {
            text <=> root.port;
            accepted => { root.ok(); }
        }
    }
    if root.kind != 1: FieldRow {
        label: "Allow from:";
        LineEdit {
            text <=> root.allow;
            placeholder-text: "addresses or networks, e.g. 192.168.1.0/24 (blank: anyone)";
            accepted => { root.ok(); }
        }
    }
    if root.kind != 2: Text { text: "Destination"; font-weight: 600; }
    if root.kind != 2: CheckBox {
        text: root.kind == 0 ? "Destination host is different from the SSH server" : "Destination host is different from this machine";
        checked <=> root.custom-host;
    }
    if root.kind != 2: FieldRow {
        label: "Hostname:";
        LineEdit {
            text <=> root.host;
            enabled: root.custom-host;
        }
    }
    if root.kind != 2: FieldRow {
        label: "Port:";
        LineEdit {
            text <=> root.host-port;
            accepted => { root.ok(); }
        }
    }
    if root.kind != 1: Text { text: "Application"; font-weight: 600; }
    if root.kind != 1: Text {
        text: "Optionally start a program on this machine once the port is listening.";
        wrap: word-wrap;
        color: Theme.text-secondary;
        font-size: 11px;
    }
    if root.kind != 1: FieldRow {
        label: "Application:";
        LineEdit { text <=> root.application; }
        Button {
            text: "...";
            clicked => { root.browse("fwd-app"); }
        }
    }
    if root.kind != 1: FieldRow {
        label: "Arguments:";
        LineEdit {
            text <=> root.arguments;
            enabled: root.application != "";
            placeholder-text: "use \"quotes\" around arguments with spaces";
        }
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.status-error;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        CheckBox {
            text: "Enabled";
            checked <=> root.enabled;
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "OK";
            primary: true;
            clicked => { root.ok(); }
        }
        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
    }
}

component CredentialDialog inherits DialogFrame {
    in-out property <string> name;
    in-out property <string> user;
    in-out property <string> password;
    in-out property <string> confirm;
    // Editing a credential that already has a saved password.
    in property <bool> has-password;
    in property <string> error;
    callback ok();
    callback cancel();
    title: "Credential";
    dialog-width: 460px;
    FieldRow {
        label: "Name:";
        LineEdit {
            text <=> root.name;
            placeholder-text: "e.g. Network admin";
            init => { self.focus(); }
            accepted => { root.ok(); }
        }
    }
    FieldRow {
        label: "Username:";
        LineEdit {
            text <=> root.user;
            placeholder-text: "blank to use each session's own username";
            accepted => { root.ok(); }
        }
    }
    FieldRow {
        label: "Password:";
        LineEdit {
            text <=> root.password;
            input-type: InputType.password;
            placeholder-text: root.has-password ? "blank to keep the saved password" : "blank to be asked each time";
            accepted => { root.ok(); }
        }
    }
    FieldRow {
        label: "Confirm:";
        LineEdit {
            text <=> root.confirm;
            input-type: InputType.password;
            accepted => { root.ok(); }
        }
    }
    Text {
        text: "The password is stored in the system keychain, never in OpenCRT's files.";
        wrap: word-wrap;
        color: Theme.text-secondary;
        font-size: 11px;
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.status-error;
        wrap: word-wrap;
    }
    DialogButtons {
        Button {
            text: "OK";
            primary: true;
            clicked => { root.ok(); }
        }
        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
    }
}

// A script's message (no input) or prompt.
component ScriptDialog inherits DialogFrame {
    in property <string> text;
    in property <bool> input;
    in property <bool> secret;
    in-out property <string> value;
    callback answer(bool);
    dialog-width: 440px;
    Text {
        text: root.text;
        wrap: word-wrap;
    }
    if root.input: LineEdit {
        text <=> root.value;
        input-type: root.secret ? InputType.password : InputType.text;
        accepted => { root.answer(true); }
        init => { self.focus(); }
    }
    DialogButtons {
        Button {
            text: "OK";
            primary: true;
            clicked => { root.answer(true); }
        }
        if root.input: Button {
            text: "Cancel";
            clicked => { root.answer(false); }
        }
    }
}

component FirewallDialog inherits DialogFrame {
    in-out property <string> name;
    // 0 SOCKS5, 1 SOCKS4, 2 HTTP, 3 gateway, 4 local command (proxy::Kind::ALL)
    in-out property <int> kind;
    in-out property <string> host;
    in-out property <string> port;
    in-out property <string> user;
    in-out property <string> password;
    in-out property <string> template;
    in property <bool> has-password;
    in property <string> error;
    callback ok();
    callback cancel();
    title: "Firewall";
    dialog-width: 500px;
    FieldRow {
        label: "Name:";
        LineEdit {
            text <=> root.name;
            placeholder-text: "e.g. Office proxy (sessions use this name)";
            init => { self.focus(); }
        }
    }
    FieldRow {
        label: "Type:";
        ComboBox {
            model: ["SOCKS5", "SOCKS4 / 4a", "HTTP CONNECT", "Gateway (send text, e.g. Wingate/TIS)", "Local proxy command"];
            current-index <=> root.kind;
        }
    }
    if root.kind != 4: FieldRow {
        label: "Host:";
        LineEdit { text <=> root.host; }
    }
    if root.kind != 4: FieldRow {
        label: "Port:";
        LineEdit { text <=> root.port; }
    }
    if root.kind <= 2: FieldRow {
        label: root.kind == 1 ? "User ID:" : "Username:";
        LineEdit {
            text <=> root.user;
            placeholder-text: "blank for none";
        }
    }
    if root.kind == 0 || root.kind == 2: FieldRow {
        label: "Password:";
        LineEdit {
            text <=> root.password;
            input-type: InputType.password;
            enabled: root.user != "";
            placeholder-text: root.has-password ? "blank to keep the saved password" : "kept in the system keychain";
        }
    }
    if root.kind >= 3: FieldRow {
        label: root.kind == 3 ? "Send:" : "Command:";
        LineEdit {
            text <=> root.template;
            placeholder-text: root.kind == 3 ? "e.g. %h %p\\r" : "e.g. nc -X connect -x proxy:8080 %h %p";
        }
    }
    if root.kind >= 3: Text {
        text: "%h and %p become the destination host and port." + (root.kind == 3 ? " \\r is Enter." : " The session talks over the command's input and output.");
        wrap: word-wrap;
        color: Theme.text-secondary;
        font-size: 11px;
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.status-error;
        wrap: word-wrap;
    }
    DialogButtons {
        Button {
            text: "OK";
            primary: true;
            clicked => { root.ok(); }
        }
        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
    }
}

// A colour field: a swatch and its #rrggbb text.
component ColourField inherits HorizontalLayout {
    in-out property <string> value;
    in property <brush> swatch;
    in property <bool> editable;
    in property <string> placeholder;
    callback edited();
    spacing: 4px;
    Rectangle {
        width: 18px;
        height: 18px;
        y: 7px;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: root.swatch;
    }
    LineEdit {
        width: 84px;
        text <=> root.value;
        enabled: root.editable;
        placeholder-text: root.placeholder;
        edited => { root.edited(); }
    }
}

component SchemesDialog inherits DialogFrame {
    in property <[string]> names;
    in-out property <int> selected;
    in-out property <string> name;
    in-out property <string> fg;
    in-out property <string> bg;
    in-out property <string> cursor;
    in-out property <string> selection;
    in-out property <[string]> ansi;
    // fg, bg, cursor, selection, then the 16 ANSI colours.
    in property <[color]> swatches;
    in property <bool> editable;
    in property <string> error;
    callback pick(int);
    callback edited();
    callback new-scheme();
    callback delete-scheme();
    callback save();
    callback close();
    title: "Colour Schemes";
    dialog-width: 760px;
    HorizontalLayout {
        spacing: 14px;
        height: 400px;
        Rectangle {
            width: 190px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.border;
            ListView {
                for name[i] in root.names: Rectangle {
                    height: 22px;
                    background: i == root.selected ? Theme.active-row-bg : sc-touch.has-hover ? Theme.hover-bg : transparent;
                    sc-touch := TouchArea {
                        clicked => { root.pick(i); }
                    }
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: name;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            alignment: start;
            FieldRow {
                label: "Name:";
                LineEdit {
                    text <=> root.name;
                    enabled: root.editable;
                }
            }
            GridLayout {
                spacing-horizontal: 10px;
                spacing-vertical: 6px;
                Row {
                    FormLabel { text: "Foreground:"; }
                    ColourField { value <=> root.fg; swatch: root.swatches[0]; editable: root.editable; edited => { root.edited(); } }
                    FormLabel { text: "Background:"; }
                    ColourField { value <=> root.bg; swatch: root.swatches[1]; editable: root.editable; edited => { root.edited(); } }
                }
                Row {
                    FormLabel { text: "Cursor:"; }
                    ColourField { value <=> root.cursor; swatch: root.swatches[2]; editable: root.editable; placeholder: "inverse"; edited => { root.edited(); } }
                    FormLabel { text: "Selection:"; }
                    ColourField { value <=> root.selection; swatch: root.swatches[3]; editable: root.editable; placeholder: "inverse"; edited => { root.edited(); } }
                }
            }
            Text { text: "ANSI colours (black, red, green, yellow, blue, magenta, cyan, white; then bright):"; color: Theme.text-secondary; font-size: 11px; }
            for row in 4: HorizontalLayout {
                spacing: 10px;
                for col in 4: ColourField {
                    value: root.ansi[row * 4 + col];
                    swatch: root.swatches[4 + row * 4 + col];
                    editable: root.editable;
                    edited => {
                        root.ansi[row * 4 + col] = self.value;
                        root.edited();
                    }
                }
            }
            Text {
                text: root.editable ? "Colours are #rrggbb. Cursor and selection may be left blank." : "Built-in schemes cannot be changed: New makes an editable copy.";
                color: Theme.text-secondary;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.error != "": Text {
                text: root.error;
                color: Theme.status-error;
                wrap: word-wrap;
            }
        }
    }
    DialogButtons {
        Button {
            text: "New";
            clicked => { root.new-scheme(); }
        }
        Button {
            text: "Delete";
            enabled: root.editable;
            clicked => { root.delete-scheme(); }
        }
        Button {
            text: "Save";
            enabled: root.editable;
            clicked => { root.save(); }
        }
        Button {
            text: "Close";
            primary: true;
            clicked => { root.close(); }
        }
    }
}

component GlobalOptionsDialog inherits DialogFrame {
    in-out property <string> key-map;
    in property <[string]> font-names;
    in-out property <int> font-index;
    in-out property <string> font-size;
    in-out property <string> scrollback;
    in-out property <string> keywords;
    in-out property <string> keepalive;
    in-out property <bool> copy-on-select;
    in-out property <string> word-delimiters;
    in-out property <string> download-folder;
    in-out property <string> config-folder;
    in-out property <string> printer;
    in-out property <string> print-font;
    in-out property <string> print-margin;
    in-out property <bool> tftp;
    in-out property <string> tftp-allow;
    // DROP_PROTOCOLS index: 0 asks.
    in-out property <int> drop-protocol;
    in-out property <bool> paste-on-right;
    in-out property <bool> paste-on-middle;
    in-out property <bool> host-clipboard;
    in-out property <bool> confirm-paste;
    in-out property <string> char-delay;
    in-out property <string> line-delay;
    in-out property <string> wait-prompt;
    in-out property <string> web-search;
    in-out property <bool> auto-reconnect;
    in-out property <bool> remember-secrets;
    in-out property <bool> reopen;
    in-out property <bool> menubar;
    in-out property <bool> connect-bar;
    in-out property <bool> confirm-disconnect;
    in-out property <bool> check-updates;
    in-out property <string> recent-count;
    in-out property <string> warn-count;
    in-out property <string> global-key;
    in-out property <int> cursor-index;
    in-out property <int> bell-index;
    in-out property <int> theme-index;
    in-out property <int> scheme-index;
    in property <[string]> scheme-names;
    in property <string> error;
    callback ok();
    callback cancel();
    callback browse(string);
    in-out property <int> category;
    title: "Global Options";
    dialog-width: 600px;
    HorizontalLayout {
        spacing: 14px;
        height: 290px;
        Rectangle {
            width: 130px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 2px;
                alignment: start;
                for page[i] in ["General", "Terminal", "Mouse", "Connection", "Highlighting", "Keyboard", "File Transfer", "Printing"]: Rectangle {
                    height: 24px;
                    background: i == root.category ? Theme.active-row-bg : page-touch.has-hover ? Theme.hover-bg : transparent;
                    Text {
                        x: 8px;
                        height: parent.height;
                        text: page;
                        vertical-alignment: center;
                    }
                    page-touch := TouchArea {
                        clicked => { root.category = i; }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            alignment: start;
            if root.category == 0: HorizontalLayout {
                spacing: 10px;
                FormLabel { text: "Theme:"; }
                ComboBox {
                    model: ["Follow the system", "Light", "Dark"];
                    current-index <=> root.theme-index;
                }
            }
            if root.category == 0: CheckBox {
                text: "Show menu bar (right-click the terminal to bring it back)";
                checked <=> root.menubar;
            }
            if root.category == 0: CheckBox {
                text: "Show connect bar";
                checked <=> root.connect-bar;
            }
            if root.category == 0: CheckBox {
                text: "Ask before closing a connected tab or exiting";
                checked <=> root.confirm-disconnect;
            }
            if root.category == 0: CheckBox {
                text: "Check for a new version at start-up";
                checked <=> root.check-updates;
            }
            if root.category == 0: GridLayout {
                spacing-horizontal: 12px;
                spacing-vertical: 8px;
                Row {
                    FormLabel { text: "Recent sessions in the File menu:"; }
                    LineEdit {
                        text <=> root.recent-count;
                        placeholder-text: "0 to 16";
                    }
                }
                Row {
                    FormLabel { text: "Ask before Connect All opens more than:"; }
                    LineEdit {
                        text <=> root.warn-count;
                        placeholder-text: "sessions; 0 = never ask";
                    }
                }
            }
            if root.category == 0: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Configuration folder:"; }
                LineEdit {
                    text <=> root.config-folder;
                    placeholder-text: "blank for the default";
                }
                Button {
                    text: "...";
                    clicked => { root.browse("go-config-dir"); }
                }
            }
            if root.category == 0: Text {
                text: "Used from the next start. Your settings are copied there if it has none yet.";
                wrap: word-wrap;
                color: Theme.text-secondary;
                font-size: 11px;
            }
            if root.category == 1: GridLayout {
                spacing-horizontal: 12px;
                spacing-vertical: 8px;
                Row {
                    FormLabel { text: "Font:"; }
                    ComboBox {
                        model: root.font-names;
                        current-index <=> root.font-index;
                    }
                }
                Row {
                    FormLabel { text: "Font size:"; }
                    LineEdit { text <=> root.font-size; }
                }
                Row {
                    FormLabel { text: "Scrollback lines:"; }
                    LineEdit { text <=> root.scrollback; }
                }
                Row {
                    FormLabel { text: "Default colour scheme:"; }
                    ComboBox {
                        model: root.scheme-names;
                        current-index <=> root.scheme-index;
                    }
                }
                Row {
                    FormLabel { text: "Cursor:"; }
                    ComboBox {
                        model: ["Block", "Underline", "Vertical bar"];
                        current-index <=> root.cursor-index;
                    }
                }
                Row {
                    FormLabel { text: "Bell:"; }
                    ComboBox {
                        model: ["Flash the window", "Play a sound", "Off"];
                        current-index <=> root.bell-index;
                    }
                }
            }
            if root.category == 2: CheckBox {
                text: "Copy on select";
                checked <=> root.copy-on-select;
            }
            if root.category == 2: CheckBox {
                text: "Paste on right-click (instead of the menu)";
                checked <=> root.paste-on-right;
            }
            if root.category == 2: CheckBox {
                text: "Paste on middle-click";
                checked <=> root.paste-on-middle;
            }
            if root.category == 2: CheckBox {
                text: "Let programs on the host copy to the clipboard (OSC 52, e.g. tmux, vim)";
                checked <=> root.host-clipboard;
            }
            if root.category == 2: CheckBox {
                text: "Ask before pasting more than one line";
                checked <=> root.confirm-paste;
            }
            // Pacing for slow devices (paste and Send ASCII File).
            if root.category == 2: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Send delays (ms):"; }
                LineEdit {
                    width: 70px;
                    text <=> root.char-delay;
                    placeholder-text: "0";
                }
                Text {
                    text: "per character";
                    vertical-alignment: center;
                }
                LineEdit {
                    width: 70px;
                    text <=> root.line-delay;
                    placeholder-text: "0";
                }
                Text {
                    text: "per line";
                    vertical-alignment: center;
                }
            }
            if root.category == 2: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Wait for prompt:"; }
                LineEdit {
                    text <=> root.wait-prompt;
                    placeholder-text: "e.g. \"# \" before each next line (blank: do not wait)";
                }
            }
            if root.category == 2: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Web search:"; }
                LineEdit {
                    text <=> root.web-search;
                    placeholder-text: "address with %s for the selected text";
                }
            }
            if root.category == 2: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Word delimiters:"; }
                LineEdit {
                    text <=> root.word-delimiters;
                    placeholder-text: "e.g. ,:;\"'()[]{}<> (blank for default)";
                }
            }
            if root.category == 3: GridLayout {
                spacing-horizontal: 12px;
                Row {
                    FormLabel { text: "SSH keepalive (seconds):"; }
                    LineEdit {
                        text <=> root.keepalive;
                        placeholder-text: "0 = off";
                    }
                }
                Row {
                    FormLabel { text: "Default SSH2 key file:"; }
                    LineEdit {
                        text <=> root.global-key;
                        placeholder-text: "blank = SSH agent";
                    }
                    Button {
                        text: "...";
                        clicked => { root.browse("go-key"); }
                    }
                }
            }
            if root.category == 3: CheckBox {
                text: "Reconnect automatically when a connection drops";
                checked <=> root.auto-reconnect;
            }
            if root.category == 3: CheckBox {
                text: "Remember passwords and key passphrases until OpenCRT closes";
                checked <=> root.remember-secrets;
            }
            if root.category == 3: CheckBox {
                text: "Reopen saved sessions that were open at exit";
                checked <=> root.reopen;
            }
            if root.category == 3: Text {
                text: "Keepalive applies to sessions opened from now on.";
                color: Theme.text-secondary;
                font-size: 11px;
            }
            if root.category == 6: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Download folder:"; }
                LineEdit {
                    text <=> root.download-folder;
                    placeholder-text: "blank for your Downloads folder";
                }
                Button {
                    text: "...";
                    clicked => { root.browse("go-download"); }
                }
            }
            if root.category == 6: CheckBox {
                text: "Run a TFTP server on this folder (UDP port 69)";
                checked <=> root.tftp;
            }
            if root.category == 6: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "TFTP clients:"; }
                LineEdit {
                    text <=> root.tftp-allow;
                    enabled: root.tftp;
                    placeholder-text: "e.g. 192.168.1.0/24, 10.0.0.5 (blank for any)";
                }
            }
            if root.category == 6: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Dropped files:"; }
                ComboBox {
                    model: ["Ask each time", "Zmodem", "Xmodem", "Ymodem", "Kermit", "ASCII", "Binary", "SFTP (SSH sessions)"];
                    current-index <=> root.drop-protocol;
                }
            }
            if root.category == 6: Text {
                text: "Zmodem and Ymodem downloads are saved here, and TFTP clients such as routers can fetch files from it or upload into it. Existing files are never overwritten.";
                wrap: word-wrap;
                color: Theme.text-secondary;
                font-size: 11px;
            }
            if root.category == 7: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Printer:"; }
                LineEdit {
                    text <=> root.printer;
                    placeholder-text: "blank for the default printer";
                }
            }
            if root.category == 7: HorizontalLayout {
                spacing: 12px;
                FormLabel { text: "Font size (points):"; }
                LineEdit {
                    width: 70px;
                    text <=> root.print-font;
                    placeholder-text: "default";
                }
                Text {
                    text: "Margins (mm):";
                    vertical-alignment: center;
                }
                LineEdit {
                    width: 70px;
                    text <=> root.print-margin;
                    placeholder-text: "default";
                }
            }
            if root.category == 7: Text {
                text: "File > Print Screen, Print Selection and Auto Print, and printing asked for by the host (CSI 5i / 4i), go to this printer. On Windows they print through Notepad, which uses its own font and margins.";
                wrap: word-wrap;
                color: Theme.text-secondary;
                font-size: 11px;
            }
            if root.category == 4: Text {
                text: "Highlight keywords, one per line, any case: a word or a /regular expression/. Add = red, orange, green, blue or purple for a colour other than amber, and \"line\" to mark the whole line (error = red line). A [name] line starts a named set that a session can choose (Session Options > Appearance) in place of the Default set: the lines above the first [name].";
                wrap: word-wrap;
            }
            if root.category == 4: TextEdit {
                text <=> root.keywords;
                height: 160px;
                font-size: 12px;
            }
            if root.category == 5: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Mapped keys (one per line):";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Import...";
                    clicked => { root.browse("go-keymap-import"); }
                }
                Button {
                    text: "Export...";
                    clicked => { root.browse("go-keymap-export"); }
                }
            }
            if root.category == 5: TextEdit {
                text <=> root.key-map;
                height: 140px;
                font-size: 12px;
            }
            if root.category == 5: Text {
                text: "Key = what it does, e.g. F5 = show running-config\\r, Ctrl+K = menu: clear-screen, Alt+F1 = run: wireshark. Keys: F1-F24, Up, Home, PageUp, Insert, Delete, Tab, Enter, Escape, Space or a character (with Ctrl or Alt), plus Ctrl+ Alt+ Shift+. Text is sent (\\r is Enter); or script: file, menu: command, run: program, telnet: brk|ayt|ip|ao|ec|el|ga|nop. Sessions can add their own (Session Options > Keyboard).";
                wrap: word-wrap;
                color: Theme.text-secondary;
                font-size: 11px;
            }
        }
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.status-error;
        wrap: word-wrap;
    }
    DialogButtons {
        Button {
            text: "OK";
            primary: true;
            clicked => { root.ok(); }
        }
        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
    }
}

component ConfirmDialog inherits DialogFrame {
    in property <string> message;
    // A tick box under the message, when it has a label.
    in property <string> option;
    in-out property <bool> checked;
    callback answer(bool);
    dialog-width: 400px;
    Text {
        text: root.message;
        wrap: word-wrap;
    }
    if root.option != "": CheckBox {
        text: root.option;
        checked <=> root.checked;
    }
    DialogButtons {
        Button {
            text: "Yes";
            primary: true;
            clicked => { root.answer(true); }
        }
        Button {
            text: "No";
            clicked => { root.answer(false); }
        }
    }
}

component NameDialog inherits DialogFrame {
    in property <string> label;
    in-out property <string> value;
    callback answer(bool);
    dialog-width: 400px;
    HorizontalLayout {
        spacing: 10px;
        FormLabel { text: root.label; }
        LineEdit {
            text <=> root.value;
            accepted => { root.answer(true); }
            init => { self.focus(); }
        }
    }
    DialogButtons {
        Button {
            text: "OK";
            primary: true;
            clicked => { root.answer(true); }
        }
        Button {
            text: "Cancel";
            clicked => { root.answer(false); }
        }
    }
}

// Several lines about to be pasted, editable before they are sent.
component PasteDialog inherits DialogFrame {
    in property <string> message;
    in-out property <string> value;
    callback answer(bool);
    title: "Paste";
    dialog-width: 560px;
    Text {
        text: root.message;
        wrap: word-wrap;
    }
    TextEdit {
        height: 240px;
        text <=> root.value;
        font-family: "IBM Plex Mono";
        font-size: 12px;
    }
    DialogButtons {
        Button {
            text: "Paste";
            primary: true;
            clicked => { root.answer(true); }
        }
        Button {
            text: "Cancel";
            clicked => { root.answer(false); }
        }
    }
}

// How to send files dropped on a session.
component DropDialog inherits DialogFrame {
    in property <string> message;
    in property <bool> sftp;
    in-out property <bool> always;
    callback answer(string);
    title: "Send Files";
    dialog-width: 520px;
    Text {
        text: root.message;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Button {
            text: "Zmodem";
            primary: true;
            clicked => { root.answer("zmodem"); }
        }
        Button {
            text: "Xmodem";
            clicked => { root.answer("xmodem"); }
        }
        Button {
            text: "Ymodem";
            clicked => { root.answer("ymodem"); }
        }
        Button {
            text: "Kermit";
            clicked => { root.answer("kermit"); }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Button {
            text: "ASCII";
            clicked => { root.answer("ascii"); }
        }
        Button {
            text: "Binary";
            clicked => { root.answer("binary"); }
        }
        if root.sftp: Button {
            text: "SFTP";
            clicked => { root.answer("sftp"); }
        }
    }
    CheckBox {
        text: "Always send dropped files this way (Global Options > File Transfer)";
        checked <=> root.always;
    }
    DialogButtons {
        Button {
            text: "Cancel";
            clicked => { root.answer(""); }
        }
    }
}

// Script > Script Editor: write, check and run Rhai scripts.
component ScriptEditor inherits DialogFrame {
    in-out property <string> text;
    in property <string> message;
    in property <bool> can-run;
    // "open", "save", "save-as", "check", "run" or "close".
    callback act(string);
    dialog-width: 800px;
    TextEdit {
        height: 440px;
        text <=> root.text;
        font-family: "IBM Plex Mono";
        font-size: 12px;
        placeholder-text: "wait_for(\"login:\", 10);\nsend(\"admin\\r\");";
    }
    Text {
        text: root.message;
        wrap: word-wrap;
        color: Theme.text-secondary;
    }
    HorizontalLayout {
        spacing: 8px;
        Button {
            text: "Open...";
            clicked => { root.act("open"); }
        }
        Button {
            text: "Save";
            clicked => { root.act("save"); }
        }
        Button {
            text: "Save As...";
            clicked => { root.act("save-as"); }
        }
        Button {
            text: "Check";
            clicked => { root.act("check"); }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Run";
            primary: true;
            enabled: root.can-run;
            clicked => { root.act("run"); }
        }
        Button {
            text: "Close";
            clicked => { root.act("close"); }
        }
    }
}

component AboutDialog inherits DialogFrame {
    in property <string> version;
    in property <string> settings-dir;
    in property <string> update-version;
    in property <string> update-status;
    // This copy can install the new version itself (Windows setup, macOS app).
    in property <bool> update-installable;
    callback check-updates();
    callback install-update();
    callback release-notes();
    callback close();
    title: "About OpenCRT";
    dialog-width: 520px;
    HorizontalLayout {
        alignment: start;
        Image {
            height: 52px;
            source: Theme.dark ? @image-url("images/brand/opencrt-lockup-horizontal-dark.svg") : @image-url("images/brand/opencrt-lockup-horizontal-light.svg");
        }
    }
    VerticalLayout {
        spacing: 2px;
        Text {
            text: "Version " + root.version;
            color: Theme.text-secondary;
            font-family: "IBM Plex Mono";
        }
        Text {
            text: "Secure terminal client for Windows, macOS and Linux.";
            font-weight: 500;
        }
        Text {
            text: "© 2026 Kim Attree";
            color: Theme.text-secondary;
        }
    }
    GridLayout {
        spacing-horizontal: 16px;
        spacing-vertical: 4px;
        Row {
            Text { text: "Protocols"; color: Theme.text-secondary; }
            Text { text: "SSH2, SFTP, Telnet, RDP, serial, raw TCP, local shell"; wrap: word-wrap; }
        }
        Row {
            Text { text: "Config"; color: Theme.text-secondary; }
            Text { text: root.settings-dir; font-family: "IBM Plex Mono"; wrap: char-wrap; }
        }
        Row {
            Text { text: "Licence"; color: Theme.text-secondary; }
            Text { text: "GPL-3.0-only, as built with Slint; source code Apache-2.0"; wrap: word-wrap; }
        }
        Row {
            Text { text: "Fonts"; color: Theme.text-secondary; }
            Text { text: "IBM Plex Sans and Mono, SIL Open Font License 1.1"; wrap: word-wrap; }
        }
    }
    AboutSlint {
        height: 96px;
    }
    if root.update-status != "": Text {
        text: root.update-status;
        wrap: word-wrap;
        font-weight: root.update-version != "" ? 600 : 400;
    }
    DialogButtons {
        Button {
            text: "Check for Updates";
            clicked => { root.check-updates(); }
        }
        if root.update-version != "": Button {
            text: "Release Notes";
            clicked => { root.release-notes(); }
        }
        if root.update-installable: Button {
            text: "Update Now";
            primary: true;
            clicked => { root.install-update(); }
        }
        Button {
            text: "OK";
            primary: !root.update-installable;
            clicked => { root.close(); }
        }
    }
}

// --- file browser tabs ---

// A list column's title; click to sort by it (again to reverse).
component ColumnHeader inherits Rectangle {
    in property <string> text;
    in property <int> column: -1;
    in property <int> sort: -1;
    in property <TextHorizontalAlignment> align: left;
    callback sort-by(int);
    background: touch.has-hover && root.column >= 0 ? Theme.hover-bg : transparent;
    Text {
        x: 6px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        font-size: 12px;
        color: Theme.text;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.column >= 0 && floor(root.sort / 2) == root.column: Path {
        x: parent.width - 13px;
        y: (parent.height - 4px) / 2;
        width: 7px;
        height: 4px;
        commands: mod(root.sort, 2) == 1 ? "M 0 0 L 7 0 L 3.5 4 Z" : "M 0 4 L 7 4 L 3.5 0 Z";
        fill: Theme.text-secondary;
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
    touch := TouchArea {
        enabled: root.column >= 0;
        clicked => { root.sort-by(root.column); }
    }
}

// One side of a file browser: where it is, what is there, and a summary.
component FileList inherits Rectangle {
    in property <bool> remote;
    in property <string> dir;
    in property <[FileRow]> rows;
    in property <string> status;
    in property <int> sort;
    in property <string> filter;
    in property <bool> hidden;
    callback go(string);
    callback click(int, bool, bool);
    callback open(int);
    callback action(string);
    callback filter-edited(string);
    // Narrow lists drop the remote-only columns first, then the type.
    property <length> size-w: 78px;
    property <length> kind-w: root.width >= 420px ? 80px : 0px;
    property <length> time-w: 116px;
    property <length> perm-w: root.remote && root.width >= 600px ? 82px : 0px;
    property <length> owner-w: root.remote && root.width >= 600px ? 90px : 0px;
    property <length> name-w: max(120px, list.visible-width - 4px - root.size-w - root.kind-w - root.time-w - root.perm-w - root.owner-w);
    // Columns are placed by x, not laid out: their widths follow the list's.
    property <length> size-x: root.name-w + 4px;
    property <length> kind-x: root.size-x + root.size-w;
    property <length> time-x: root.kind-x + root.kind-w;
    property <length> perm-x: root.time-x + root.time-w;
    property <length> owner-x: root.perm-x + root.perm-w;
    background: Theme.panel-bg;
    changed dir => { path.text = root.dir; }
    changed filter => {
        if filter-edit.text != root.filter {
            filter-edit.text = root.filter;
        }
    }
    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: root.remote ? "Download" : "Upload";
                activated => { root.action("transfer"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "New Folder...";
                activated => { root.action("mkdir"); }
            }
            MenuItem {
                title: "Rename...";
                activated => { root.action("rename"); }
            }
            MenuItem {
                title: "Delete";
                activated => { root.action("delete"); }
            }
            MenuItem {
                title: "Copy Path";
                activated => { root.action("copy-path"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Refresh";
                activated => { root.action("refresh"); }
            }
        }
        VerticalLayout {
            HorizontalLayout {
                padding: 4px;
                spacing: 6px;
                FormLabel {
                    text: root.remote ? "Remote site:" : "Local site:";
                    font-size: 12px;
                }
                path := LineEdit {
                    init => { self.text = root.dir; }
                    accepted(text) => { root.go(text); }
                }
                Button {
                    text: "Up";
                    clicked => { root.action("up"); }
                }
            }
            Rectangle {
                height: 22px;
                background: Theme.window-bg;
                ColumnHeader {
                    x: 0px;
                    width: root.size-x;
                    text: "Filename";
                    column: 0;
                    sort: root.sort;
                    sort-by(c) => { root.action("sort-" + c); }
                }
                ColumnHeader {
                    x: root.size-x;
                    width: root.size-w;
                    text: "Filesize";
                    column: 1;
                    sort: root.sort;
                    align: right;
                    sort-by(c) => { root.action("sort-" + c); }
                }
                if root.kind-w > 0: ColumnHeader {
                    x: root.kind-x;
                    width: root.kind-w;
                    text: "Filetype";
                    column: 2;
                    sort: root.sort;
                    sort-by(c) => { root.action("sort-" + c); }
                }
                ColumnHeader {
                    x: root.time-x;
                    width: root.time-w;
                    text: "Last modified";
                    column: 3;
                    sort: root.sort;
                    sort-by(c) => { root.action("sort-" + c); }
                }
                if root.perm-w > 0: ColumnHeader {
                    x: root.perm-x;
                    width: root.perm-w;
                    text: "Permissions";
                    column: 4;
                    sort: root.sort;
                    sort-by(c) => { root.action("sort-" + c); }
                }
                if root.owner-w > 0: ColumnHeader {
                    x: root.owner-x;
                    width: root.owner-w;
                    text: "Owner/Group";
                    column: 5;
                    sort: root.sort;
                    sort-by(c) => { root.action("sort-" + c); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                // Right-click below the rows: the menu, with nothing picked.
                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.click(-1, false, false);
                            if (event.button == PointerEventButton.right) {
                                menu.show({ x: self.absolute-position.x + self.mouse-x - menu.absolute-position.x, y: self.absolute-position.y + self.mouse-y - menu.absolute-position.y });
                            }
                        }
                    }
                }
                list := ListView {
                    for row[i] in root.rows: Rectangle {
                        height: 20px;
                        background: row.selected ? Theme.active-row-bg : touch.has-hover ? Theme.hover-bg : transparent;
                        touch := TouchArea {
                            double-clicked => { root.open(i); }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.click(i, event.modifiers.control, event.modifiers.shift);
                                } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    if (!row.selected) {
                                        root.click(i, false, false);
                                    }
                                    menu.show({ x: self.absolute-position.x + self.mouse-x - menu.absolute-position.x, y: self.absolute-position.y + self.mouse-y - menu.absolute-position.y });
                                }
                            }
                        }
                        Icon {
                            x: 4px;
                            y: (parent.height - self.height) / 2;
                            kind: row.dir ? IconKind.folder : IconKind.file;
                        }
                        TableCell {
                            x: 24px;
                            width: root.size-x - 28px;
                            height: parent.height;
                            text: row.name;
                        }
                        TableCell {
                            x: root.size-x;
                            width: root.size-w - 6px;
                            height: parent.height;
                            text: row.size;
                            horizontal-alignment: right;
                        }
                        if root.kind-w > 0: TableCell {
                            x: root.kind-x + 6px;
                            width: root.kind-w - 10px;
                            height: parent.height;
                            text: row.kind;
                        }
                        TableCell {
                            x: root.time-x + 6px;
                            width: root.time-w - 10px;
                            height: parent.height;
                            text: row.modified;
                        }
                        if root.perm-w > 0: TableCell {
                            x: root.perm-x + 6px;
                            width: root.perm-w - 10px;
                            height: parent.height;
                            text: row.permissions;
                        }
                        if root.owner-w > 0: TableCell {
                            x: root.owner-x + 6px;
                            width: root.owner-w - 10px;
                            height: parent.height;
                            text: row.owner;
                        }
                    }
                }
            }
            Rectangle {
                height: 30px;
                background: Theme.window-bg;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 4px;
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.status;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    filter-edit := LineEdit {
                        width: 130px;
                        placeholder-text: "Filter";
                        init => { self.text = root.filter; }
                        edited(text) => { root.filter-edited(text); }
                    }
                    CheckBox {
                        text: "Hidden";
                        checked: root.hidden;
                        toggled => { root.action(self.checked ? "hidden-on" : "hidden-off"); }
                    }
                }
            }
        }
    }
}

// The transfer queue: waiting (the running one first), failed and finished jobs.
component TransferQueue inherits Rectangle {
    in property <[QueueRow]> rows;
    in property <int> list;
    in property <int> waiting;
    in property <int> failed;
    in property <int> finished;
    callback click(int, bool, bool);
    callback action(string);
    property <length> dir-w: 70px;
    property <length> size-w: 78px;
    property <length> status-w: 230px;
    property <length> path-w: max(100px, (rows-view.visible-width - 4px - root.dir-w - root.size-w - root.status-w) / 2);
    property <length> dir-x: root.path-w + 4px;
    property <length> remote-x: root.dir-x + root.dir-w;
    property <length> size-x: root.remote-x + root.path-w;
    property <length> status-x: root.size-x + root.size-w;
    background: Theme.panel-bg;
    menu := ContextMenuArea {
        Menu {
            if root.list == 0: MenuItem {
                title: "Cancel Transfer";
                activated => { root.action("cancel"); }
            }
            if root.list == 1: MenuItem {
                title: "Retry";
                activated => { root.action("retry"); }
            }
            MenuItem {
                title: "Remove";
                activated => { root.action("remove"); }
            }
            MenuItem {
                title: "Clear List";
                activated => { root.action("clear"); }
            }
        }
        VerticalLayout {
            Rectangle {
                height: 22px;
                background: Theme.window-bg;
                ColumnHeader {
                    x: 0px;
                    width: root.dir-x;
                    text: "Local file";
                }
                ColumnHeader {
                    x: root.dir-x;
                    width: root.dir-w;
                    text: "Direction";
                }
                ColumnHeader {
                    x: root.remote-x;
                    width: root.path-w;
                    text: "Remote file";
                }
                ColumnHeader {
                    x: root.size-x;
                    width: root.size-w;
                    text: "Size";
                    align: right;
                }
                ColumnHeader {
                    x: root.status-x;
                    width: root.status-w;
                    text: root.list == 1 ? "Reason" : "Status";
                }
            }
            Rectangle {
                vertical-stretch: 1;
                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.click(-1, false, false);
                            if (event.button == PointerEventButton.right) {
                                menu.show({ x: self.absolute-position.x + self.mouse-x - menu.absolute-position.x, y: self.absolute-position.y + self.mouse-y - menu.absolute-position.y });
                            }
                        }
                    }
                }
                rows-view := ListView {
                    for row[i] in root.rows: Rectangle {
                        height: 20px;
                        background: row.selected ? Theme.active-row-bg : touch.has-hover ? Theme.hover-bg : transparent;
                        if row.progress >= 0: Rectangle {
                            x: root.status-x;
                            width: root.status-w * row.progress;
                            background: Theme.accent.with-alpha(0.25);
                        }
                        touch := TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.click(i, event.modifiers.control, event.modifiers.shift);
                                } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    if (!row.selected) {
                                        root.click(i, false, false);
                                    }
                                    menu.show({ x: self.absolute-position.x + self.mouse-x - menu.absolute-position.x, y: self.absolute-position.y + self.mouse-y - menu.absolute-position.y });
                                }
                            }
                        }
                        TableCell {
                            x: 6px;
                            width: root.dir-x - 10px;
                            height: parent.height;
                            text: row.local;
                        }
                        TableCell {
                            x: root.dir-x;
                            width: root.dir-w;
                            height: parent.height;
                            text: row.upload ? "-->" : "<--";
                            horizontal-alignment: center;
                        }
                        TableCell {
                            x: root.remote-x + 6px;
                            width: root.path-w - 10px;
                            height: parent.height;
                            text: row.remote;
                        }
                        TableCell {
                            x: root.size-x;
                            width: root.size-w - 6px;
                            height: parent.height;
                            text: row.size;
                            horizontal-alignment: right;
                        }
                        TableCell {
                            x: root.status-x + 6px;
                            width: root.status-w - 10px;
                            height: parent.height;
                            text: row.status;
                            color: root.list == 1 ? Theme.status-error : Theme.text;
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 26px;
                padding: 2px;
                spacing: 2px;
                alignment: start;
                for name[k] in ["Queued files (" + root.waiting + ")", "Failed transfers (" + root.failed + ")", "Successful transfers (" + root.finished + ")"]: Rectangle {
                    width: label.preferred-width + 20px;
                    border-width: 1px;
                    border-color: k == root.list ? Theme.border-strong : Theme.border;
                    background: k == root.list ? Theme.tab-active-bg : tab-touch.has-hover ? Theme.hover-bg : Theme.tab-inactive-bg;
                    label := Text {
                        text: name;
                        font-size: 12px;
                        font-weight: k == root.list ? 600 : 400;
                        color: Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tab-touch := TouchArea {
                        clicked => { root.action("list-" + k); }
                    }
                }
            }
        }
    }
}

// A file browser tab: local and remote lists side by side, the queue below.
component FilesBrowser inherits Rectangle {
    in property <FilesView> view;
    // `side`: 0 local, 1 remote, 2 the queue.
    callback click(int, int, bool, bool);
    callback open(int, int);
    callback go(int, string);
    callback action(int, string);
    callback filter(int, string);
    background: Theme.window-bg;
    // Keeps pointer events off the terminal underneath.
    TouchArea { }
    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 3;
            FileList {
                width: (root.width - 1px) / 2;
                remote: false;
                dir: root.view.local-dir;
                rows: root.view.local-rows;
                status: root.view.local-status;
                sort: root.view.local-sort;
                filter: root.view.local-filter;
                hidden: root.view.local-hidden;
                filter-edited(text) => { root.filter(0, text); }
                go(text) => { root.go(0, text); }
                click(row, ctrl, shift) => { root.click(0, row, ctrl, shift); }
                open(row) => { root.open(0, row); }
                action(name) => { root.action(0, name); }
            }
            Rectangle {
                width: 1px;
                background: Theme.border-strong;
            }
            FileList {
                width: (root.width - 1px) / 2;
                remote: true;
                dir: root.view.remote-dir;
                rows: root.view.remote-rows;
                status: root.view.remote-status;
                sort: root.view.remote-sort;
                filter: root.view.remote-filter;
                hidden: root.view.remote-hidden;
                filter-edited(text) => { root.filter(1, text); }
                go(text) => { root.go(1, text); }
                click(row, ctrl, shift) => { root.click(1, row, ctrl, shift); }
                open(row) => { root.open(1, row); }
                action(name) => { root.action(1, name); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border-strong;
        }
        TransferQueue {
            vertical-stretch: 2;
            min-height: 120px;
            rows: root.view.queue;
            list: root.view.list;
            waiting: root.view.waiting;
            failed: root.view.failed;
            finished: root.view.finished;
            click(row, ctrl, shift) => { root.click(2, row, ctrl, shift); }
            action(name) => { root.action(2, name); }
        }
    }
}

// Quick Open: type to find a saved session, or an address to connect to.
component QuickOpenDialog inherits DialogFrame {
    in property <[QuickRow]> rows;
    in-out property <int> selected;
    in-out property <string> query;
    callback edited(string);
    // Row (-1 to close), and whether to open it as an SFTP GUI tab.
    callback answer(int, bool);
    property <length> row-h: 36px;
    dialog-width: 560px;
    title: "Quick Open";
    // Keys are taken before the search box sees them, so it keeps the focus.
    FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.selected = max(0, min(root.rows.length - 1, root.selected + (event.text == Key.UpArrow ? -1 : 1)));
                if (root.selected * root.row-h + list.content-y < 0) {
                    list.content-y = -root.selected * root.row-h;
                }
                if ((root.selected + 1) * root.row-h + list.content-y > list.visible-height) {
                    list.content-y = list.visible-height - (root.selected + 1) * root.row-h;
                }
                return accept;
            }
            if (event.text == Key.Return) {
                root.answer(root.rows.length > 0 ? root.selected : -1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.Escape) {
                root.answer(-1, false);
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            spacing: 8px;
            LineEdit {
                text <=> root.query;
                placeholder-text: "Search saved sessions, or type user@host";
                edited(text) => { root.edited(text); }
                init => { self.focus(); }
            }
            list := ListView {
                height: 8 * root.row-h;
                for row[i] in root.rows: Rectangle {
                    height: root.row-h;
                    background: i == root.selected ? Theme.active-row-bg : touch.has-hover ? Theme.hover-bg : transparent;
                    touch := TouchArea {
                        clicked => { root.selected = i; }
                        double-clicked => { root.answer(i, false); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            kind: row.typed ? IconKind.quick-connect : Icons.protocol-icon(row.protocol);
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: row.label;
                                font-size: 13px;
                                overflow: elide;
                            }
                            if row.detail != "": Text {
                                text: row.detail;
                                font-size: 11px;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            Text {
                text: root.rows.length == 0 ? "No saved session matches." : "Enter connects  ·  Shift+Enter opens an SFTP GUI tab  ·  Esc closes";
                font-size: 11px;
                color: Theme.text-secondary;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: root.window-title;
    icon: @image-url("opencrt.svg");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 300px;
    // Flipped to repaint the whole window (after being minimised); the two
    // backgrounds look the same.
    in-out property <bool> repaint-all;
    background: root.repaint-all ? Theme.window-bg.with-alpha(0.996) : Theme.window-bg;
    default-font-family: "IBM Plex Sans";
    default-font-size: 12px;

    // --- state pushed from Rust ---
    in property <string> window-title: "OpenCRT";
    in property <string> version;
    in property <string> settings-dir;
    in property <[PaneData]> panes;
    // File browser tabs on screen, drawn over their panes.
    in property <[FilesView]> files-views;
    callback files-click(int, int, int, bool, bool);
    callback files-open(int, int, int);
    callback files-go(int, int, string);
    callback files-action(int, int, string);
    callback files-filter(int, int, string);
    in property <color> terminal-bg: black;
    in property <image> dock-label-sessions;
    in property <image> dock-label-active;
    in property <image> dock-label-commands;
    in property <image> dock-label-scratch;
    in property <[TabData]> tabs;
    // The tabs Active Sessions lists (its filter applied).
    in property <[TabData]> active-tabs;
    // Tab groups side by side (1 when there are none, or the tabs are tiled).
    in property <int> group-count: 1;
    in property <int> active-tab;
    in property <int> scroll-offset;
    in property <int> scroll-history;
    in property <int> scroll-rows;
    in property <bool> mouse-reporting;
    // The active tab shows a remote desktop: its mouse goes to the server.
    in property <bool> remote-desktop;
    in property <bool> has-selection;
    in property <bool> bell;
    // The active tab has a live connection / can be reconnected.
    in property <bool> session-live;
    in property <bool> session-closed;
    // The active tab is running a script (Script > Run).
    in property <bool> script-running;
    // The active tab is recording a script (Script > Start Recording).
    in property <bool> recording;
    // The active tab is writing a log file.
    in property <bool> logging;
    // Transfer > Receive ASCII is writing the active tab's output to a file.
    in property <bool> capturing;
    // File > Auto Print is collecting the active tab's output.
    in property <bool> auto-printing;
    // The active tab is an SSH2 shell (SFTP tabs can be opened from it).
    in property <bool> ssh-active;
    in property <string> status-text: "Ready";
    // A newer release's version ("" when none), and the About dialog's line about updates.
    in property <string> update-version;
    in property <string> update-status;
    in property <bool> update-installable;
    in property <string> status-cipher;
    in property <string> status-pos;
    in property <string> status-size;
    in property <string> status-emulation;
    in property <bool> show-locks;
    in property <bool> caps-on;
    in property <bool> num-on;
    in-out property <bool> show-toolbar: true;
    in-out property <bool> show-statusbar: true;
    in-out property <bool> show-menubar: true;
    in-out property <bool> show-connect-bar: true;
    // Saved-session paths for the File menu, newest first.
    in property <[string]> recent-sessions;
    in property <[string]> snapshots;
    in-out property <bool> sessions-open: false;
    in-out property <length> dock-width: 240px;
    in-out property <bool> active-open: false;
    in-out property <bool> commands-open: false;
    in-out property <bool> scratch-open: false;
    in-out property <string> scratch-text;
    in property <int> scratch-sel-start;
    in property <int> scratch-sel-end;
    in property <int> scratch-sel-serial;
    callback scratch-act(string);
    // Keyboard, paste and command input goes to every connected tab.
    in-out property <bool> send-to-all: false;
    // View > Full Screen / Always on Top, applied through the Window's own properties.
    in-out property <bool> command-window: false;
    // Command Window: 0 the active tab, 1 all tabs, 2 tabs on screen.
    in-out property <int> cw-target;
    in-out property <string> cw-text;
    in-out property <bool> cw-immediate;
    in property <[string]> cw-history;
    // View > Hex View: the active tab's latest received bytes.
    in-out property <bool> hex-view: false;
    in property <[string]> hex-lines;
    // View > Show Control Characters, for the active tab.
    in-out property <bool> show-controls: false;
    in-out property <bool> view-full-screen: false;
    in-out property <bool> view-on-top: false;
    full-screen: root.view-full-screen;
    always-on-top: root.view-on-top;
    in-out property <bool> find-open: false;
    in-out property <bool> show-button-bar: false;
    in property <[BarRow]> bar-buttons;
    // The named bar shown (empty: the default bar).
    in property <string> bar-name;
    in property <[CommandRow]> command-rows;
    in-out property <int> command-selected: -1;
    in property <string> bb-title;
    // Tools > Host Keys: one line per saved key.
    in property <[string]> host-keys;
    in-out property <int> host-key-selected: -1;
    in-out property <string> kg-passphrase;
    in property <[string]> kg-types;
    in-out property <int> kg-type;
    in property <bool> kg-busy;
    in-out property <string> kg-confirm;
