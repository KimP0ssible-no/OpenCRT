    in property <string> script-title: "Script";
    in property <string> script-text;
    in property <[string]> agent-rows;
    in-out property <int> agent-selected: -1;
    in-out property <bool> agent-load;
    in property <bool> script-input;
    in property <bool> script-secret;
    in-out property <string> script-value;
    in-out property <bool> auth-save;
    in-out property <string> qc-host;
    in-out property <string> qc-port: "22";
    in-out property <string> qc-user;
    in-out property <string> qc-key;
    in-out property <bool> qc-save;
    in-out property <int> qc-protocol;
    in-out property <string> qc-serial-port;
    in-out property <string> qc-baud;
    in property <string> qc-error;
    in property <[string]> serial-ports;
    in-out property <int> so-protocol;
    in-out property <string> so-serial-port;
    in-out property <string> so-baud;
    in-out property <int> so-line-data;
    in-out property <int> so-line-parity;
    in-out property <int> so-line-stop;
    in-out property <int> so-line-flow;
    in-out property <int> qc-line-data;
    in-out property <int> qc-line-parity;
    in-out property <int> qc-line-stop;
    in-out property <int> qc-line-flow;

    // --- state read by Rust ---
    out property <length> term-width: term-area.width;
    out property <length> term-height: term-area.height;
    out property <bool> term-focused: fs.has-focus;

    // --- events to Rust ---
    callback terminal-key(string, bool, bool, bool, bool) -> bool;
    // kind: 0 down, 1 up, 2 move; button: 0 left, 1 right, 2 middle, 3 none
    callback terminal-pointer(int, int, length, length, bool, bool, bool);
    // delta, pointer x and y, ctrl, alt, shift
    callback terminal-scroll(length, length, length, bool, bool, bool) -> bool;
    callback scrollbar-set(float);
    callback select-tab(int);
    callback close-tab(int);
    callback tab-action(int, string);
    callback action(string);
    // The menu bar stays clickable over the modal dialogs; its actions wait until they close.
    callback menu(string);
    menu(name) => {
        if root.dialog == 0 {
            root.action(name);
        }
    }
    callback connect-bar(string);
    // Quick Open (dialog 20).
    in property <[QuickRow]> quick-rows;
    in-out property <int> quick-selected;
    in-out property <string> quick-query;
    callback quick-edited(string);
    callback quick-answer(int, bool);
    // Words to highlight until the field is cleared (ad hoc, beside the saved keywords).
    callback adhoc-highlight(string);
    in property <string> paste-message;
    in-out property <string> paste-value;
    callback paste-answer(bool);
    callback hostkey-answer(int);
    callback auth-answer(bool);
    callback quick-connect();
    // text, match case, backwards
    callback find(string, bool, bool);
    // Fill a dialog field from a native file dialog: qc-key, so-key or so-log.
    callback browse(string);
    callback bar-button(int);
    // -1 adds a new button.
    callback bar-button-edit(int);
    callback bar-button-delete(int);
    callback bar-button-ok();
    callback keygen-ok();
    callback keygen-type();
    // A line from the command window; Enter is added.
    callback command-line(string);
    callback command-chars(string);
    callback command-send(int);
    callback command-to-bar(int);
    callback active-pick(int, bool);
    callback active-act(string);
    callback active-filter(string);
    callback command-filter(string);
    // -1 adds a new command.
    callback command-edit(int);
    callback command-delete(int);
    callback command-folder(string);
    callback session-activate(int);
    callback session-toggle(int);
    callback session-pick(int, bool);
    callback session-action(string);
    callback session-filter(string);
    callback session-options-ok();
    callback forward-edit(int);
    callback forward-remove(int);
    callback forward-ok();
    callback credential-edit(int);
    callback credential-remove(int);
    callback credential-ok();
    callback firewall-edit(int);
    callback firewall-remove(int);
    callback firewall-ok();
    callback script-answer(bool);
    callback global-options-ok();
    callback confirm-answer(bool);
    callback name-answer(bool);

    public function focus-terminal() {
        fs.focus();
    }

    // Global Options > Appearance: 0 follow the system, 1 light, 2 dark. Left
    // alone at 0, the style keeps following the system as it changes.
    in property <int> theme-mode;
    changed theme-mode => {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    init => {
        fs.focus();
    }

    MenuBar {
        visible: root.show-menubar;
        Menu {
            title: "File";
            MenuItem {
                title: "Quick Connect...";
                activated => { root.menu("quick-connect"); }
            }
            MenuItem {
                title: "Quick Open... (Ctrl+Shift+T)";
                activated => { root.menu("quick-open"); }
            }
            MenuItem {
                title: "Connect in Tab...";
                activated => { root.menu("quick-connect"); }
            }
            MenuItem {
                title: "Connect Local Shell";
                activated => { root.menu("local-shell"); }
            }
            MenuItem {
                title: "Clone Session";
                enabled: root.tabs.length > 0;
                activated => { root.menu("clone"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Reconnect";
                enabled: root.session-closed;
                activated => { root.menu("reconnect"); }
            }
            MenuItem {
                title: "Disconnect";
                enabled: root.session-live;
                activated => { root.menu("disconnect"); }
            }
            MenuItem {
                title: "Disconnect All";
                enabled: root.tabs.length > 0;
                activated => { root.menu("disconnect-all"); }
            }
            MenuItem {
                title: "Close Tab";
                enabled: root.tabs.length > 0;
                activated => { root.menu("close-tab"); }
            }
            MenuSeparator { }
            MenuItem {
                title: root.logging ? "Stop Logging" : "Log Session...";
                enabled: root.tabs.length > 0;
                activated => { root.menu("log-session"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Print Screen";
                enabled: root.tabs.length > 0;
                activated => { root.menu("print-screen"); }
            }
            MenuItem {
                title: "Print Selection";
                enabled: root.has-selection;
                activated => { root.menu("print-selection"); }
            }
            MenuItem {
                title: root.auto-printing ? "Stop Auto Print" : "Auto Print";
                enabled: root.tabs.length > 0;
                activated => { root.menu("auto-print"); }
            }
            MenuSeparator { }
            Menu {
                title: "Snapshots";
                MenuItem {
                    title: "Save Snapshot...";
                    enabled: root.tabs.length > 0;
                    activated => { root.menu("snapshot-save"); }
                }
                if root.snapshots.length > 0: MenuSeparator { }
                for name[i] in root.snapshots: MenuItem {
                    title: name;
                    activated => { root.menu("snapshot-open-" + i); }
                }
                if root.snapshots.length > 0: Menu {
                    title: "Delete";
                    for name[i] in root.snapshots: MenuItem {
                        title: name;
                        activated => { root.menu("snapshot-delete-" + i); }
                    }
                }
            }
            MenuSeparator { }
            for path[i] in root.recent-sessions: MenuItem {
                title: (i + 1) + "  " + path;
                activated => { root.menu("recent-" + i); }
            }
            if root.recent-sessions.length > 0: MenuSeparator { }
            MenuItem {
                title: "Exit";
                activated => { root.menu("exit"); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Copy";
                enabled: root.has-selection;
                activated => { root.menu("copy"); }
            }
            MenuItem {
                title: "Copy with Colours";
                enabled: root.has-selection;
                activated => { root.menu("copy-html"); }
            }
            MenuItem {
                title: "Paste";
                enabled: root.session-live;
                activated => { root.menu("paste"); }
            }
            MenuItem {
                title: "Copy and Paste";
                enabled: root.has-selection && root.session-live;
                activated => { root.menu("copy-paste"); }
            }
            MenuItem {
                title: "Select All";
                enabled: root.tabs.length > 0;
                activated => { root.menu("select-all"); }
            }
            MenuItem {
                title: "Find...";
                enabled: root.tabs.length > 0;
                activated => {
                    if root.dialog == 0 {
                        root.find-open = true;
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Clear Screen";
                enabled: root.tabs.length > 0;
                activated => { root.menu("clear-screen"); }
            }
            MenuItem {
                title: "Clear Scrollback";
                enabled: root.tabs.length > 0;
                activated => { root.menu("clear-scrollback"); }
            }
            MenuItem {
                title: "Clear Screen and Scrollback";
                enabled: root.tabs.length > 0;
                activated => { root.menu("clear-all"); }
            }
            MenuItem {
                title: "Reset Terminal";
                enabled: root.tabs.length > 0;
                activated => { root.menu("reset"); }
            }
            MenuItem {
                title: "Send Break";
                enabled: root.session-live;
                activated => { root.menu("send-break"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Send Input to All Tabs";
                checkable: true;
                checked <=> root.send-to-all;
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Toolbar";
                checkable: true;
                checked <=> root.show-toolbar;
            }
            MenuItem {
                title: "Status Bar";
                checkable: true;
                checked <=> root.show-statusbar;
            }
            MenuItem {
                title: "Session Manager";
                checkable: true;
                checked <=> root.sessions-open;
            }
            MenuItem {
                title: "Command Manager";
                checkable: true;
                checked <=> root.commands-open;
            }
            MenuItem {
                title: "Command Window";
                checkable: true;
                checked <=> root.command-window;
            }
            MenuItem {
                title: "Hex View";
                checkable: true;
                checked <=> root.hex-view;
            }
            MenuItem {
                title: "Show Control Characters";
                checkable: true;
                checked <=> root.show-controls;
                enabled: root.tabs.length > 0;
            }
            MenuItem {
                title: "Button Bar";
                checkable: true;
                checked <=> root.show-button-bar;
            }
            MenuSeparator { }
            MenuItem {
                title: "Full Screen";
                checkable: true;
                checked <=> root.view-full-screen;
            }
            MenuItem {
                title: "Always on Top";
                checkable: true;
                checked <=> root.view-on-top;
            }
            MenuSeparator { }
            // Same as Ctrl+mouse wheel.
            MenuItem {
                title: "Larger Font";
                activated => { root.menu("font-larger"); }
            }
            MenuItem {
                title: "Smaller Font";
                activated => { root.menu("font-smaller"); }
            }
        }
        Menu {
            title: "Options";
            MenuItem {
                title: "Session Options...";
                enabled: root.tabs.length > 0;
                activated => { root.menu("session-options"); }
            }
            MenuItem {
                title: "Default Session...";
                activated => { root.menu("default-session"); }
            }
            MenuItem {
                title: "Firewalls...";
                activated => { root.menu("firewalls"); }
            }
            MenuItem {
                title: "Colour Schemes...";
                activated => { root.menu("colour-schemes"); }
            }
            MenuItem {
                title: "Global Options...";
                activated => { root.menu("global-options"); }
            }
        }
        Menu {
            title: "Transfer";
            MenuItem {
                title: "Connect SFTP Tab";
                enabled: root.ssh-active;
                activated => { root.menu("sftp-tab"); }
            }
            MenuItem {
                title: "Connect SFTP GUI Tab";
                enabled: root.ssh-active;
                activated => { root.menu("sftp-gui-tab"); }
            }
            MenuItem {
                title: "Send ASCII File...";
                enabled: root.session-live;
                activated => { root.menu("send-ascii"); }
            }
            MenuItem {
                title: "Send Binary File...";
                enabled: root.session-live;
                activated => { root.menu("send-binary"); }
            }
            MenuItem {
                title: root.capturing ? "Stop Receive ASCII" : "Receive ASCII...";
                enabled: root.session-live || root.capturing;
                activated => { root.menu("receive-ascii"); }
            }
            MenuItem {
                title: "Zmodem Upload...";
                enabled: root.session-live;
                activated => { root.menu("zmodem-upload"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Send Xmodem...";
                enabled: root.session-live;
                activated => { root.menu("xmodem-send"); }
            }
            MenuItem {
                title: "Receive Xmodem...";
                enabled: root.session-live;
                activated => { root.menu("xmodem-receive"); }
            }
            MenuItem {
                title: "Send Ymodem...";
                enabled: root.session-live;
                activated => { root.menu("ymodem-send"); }
            }
            MenuItem {
                title: "Receive Ymodem";
                enabled: root.session-live;
                activated => { root.menu("ymodem-receive"); }
            }
            MenuItem {
                title: "Send Kermit...";
                enabled: root.session-live;
                activated => { root.menu("kermit-send"); }
            }
            MenuItem {
                title: "Receive Kermit";
                enabled: root.session-live;
                activated => { root.menu("kermit-receive"); }
            }
        }
        Menu {
            title: "Script";
            MenuItem {
                title: "Run...";
                enabled: root.tabs.length > 0 && !root.session-closed && !root.script-running;
                activated => { root.menu("run-script"); }
            }
            MenuItem {
                title: "Cancel";
                enabled: root.script-running;
                activated => { root.menu("cancel-script"); }
            }
            MenuItem {
                title: "Script Editor...";
                activated => { root.menu("script-editor"); }
            }
            MenuSeparator {}
            MenuItem {
                title: root.recording ? "Stop Recording..." : "Start Recording";
                enabled: root.recording || (root.tabs.length > 0 && !root.session-closed);
                activated => { root.menu("record-script"); }
            }
        }
        Menu {
            title: "Tools";
            MenuItem {
                title: "Create Public Key...";
                activated => { root.menu("create-key"); }
            }
            MenuItem {
                title: "Host Keys...";
                activated => { root.menu("host-keys"); }
            }
            MenuItem {
                title: "Credentials Manager...";
                activated => { root.menu("credentials"); }
            }
            MenuItem {
                title: "Agent Keys...";
                activated => { root.menu("agent-keys"); }
            }
            MenuItem {
                title: "Public Key Assistant...";
                activated => { root.menu("upload-key"); }
            }
            MenuItem {
                title: "Convert Private Key to OpenSSH...";
                activated => { root.menu("convert-key"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Import OpenSSH Config";
                activated => { root.menu("import-ssh-config"); }
            }
            MenuItem {
                title: "Import SecureCRT Sessions...";
                activated => { root.menu("import-securecrt"); }
            }
            MenuItem {
                title: "Import Sessions...";
                activated => { root.menu("import-sessions"); }
            }
            MenuItem {
                title: "Export Sessions...";
                activated => { root.menu("export-sessions"); }
            }
        }
        Menu {
            title: "Window";
            MenuItem {
                title: "Next Tab";
                enabled: root.tabs.length > 1;
                activated => { root.menu("next-tab"); }
            }
            MenuItem {
                title: "Previous Tab";
                enabled: root.tabs.length > 1;
                activated => { root.menu("previous-tab"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Tile Vertically";
                enabled: root.tabs.length > 1;
                activated => { root.menu("tile-columns"); }
            }
            MenuItem {
                title: "Tile Horizontally";
                enabled: root.tabs.length > 1;
                activated => { root.menu("tile-rows"); }
            }
            MenuItem {
                title: "Untile";
                activated => { root.menu("untile"); }
            }
            MenuItem {
                title: "Merge Tab Groups";
                enabled: root.group-count > 1;
                activated => { root.menu("merge-groups"); }
            }
            if root.tabs.length > 0: MenuSeparator { }
            // One entry per open tab.
            for tab[i] in root.tabs: MenuItem {
                title: (i + 1) + "  " + tab.title;
                activated => {
                    if root.dialog == 0 {
                        root.select-tab(i);
                    }
                }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Check for Updates";
                activated => { root.menu("check-updates"); }
            }
            MenuItem {
                title: "About OpenCRT";
                activated => {
                    // Like root.menu: never replace an open dialog (prompts would go unanswered).
                    if root.dialog == 0 {
                        root.dialog = 4;
                    }
                }
            }
        }
    }

    VerticalLayout {
        // --- toolbar ---
        if root.show-toolbar: Rectangle {
            height: 30px;
            background: Theme.toolbar-bg;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding: 3px;
                padding-left: 4px;
                spacing: 1px;
                alignment: start;
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.sessions;
                    clicked => { root.sessions-open = !root.sessions-open; }
                }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.quick-connect;
                    clicked => { root.action("quick-connect"); }
                }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.connect-tab;
                    clicked => { root.action("quick-connect"); }
                }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.local-shell;
                    clicked => { root.action("local-shell"); }
                }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.reconnect;
                    enabled: root.session-closed;
                    clicked => { root.action("reconnect"); }
                }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.disconnect;
                    enabled: root.session-live;
                    clicked => { root.action("disconnect"); }
                }
                if root.show-connect-bar: ToolSeparator { }
                if root.show-connect-bar: CompactInput {
                    width: 170px;
                    placeholder: "Quick connect: user@host";
                    clear-on-submit: true;
                    submitted(text) => { root.connect-bar(text); }
                }
                ToolSeparator { }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.copy;
                    enabled: root.has-selection;
                    clicked => { root.action("copy"); }
                }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.paste;
                    enabled: root.session-live;
                    clicked => { root.action("paste"); }
                }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.find;
                    enabled: root.tabs.length > 0;
                    clicked => { root.find-open = !root.find-open; }
                }
                CompactInput {
                    width: 120px;
                    placeholder: "Highlight words";
                    edited(text) => { root.adhoc-highlight(text); }
                }
                ToolSeparator { }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.print;
                    enabled: root.tabs.length > 0;
                    clicked => { root.action("print-screen"); }
                }
                ToolButton {
                    icon-size: 20px;
                    icon: IconKind.options;
                    enabled: root.tabs.length > 0;
                    clicked => { root.action("session-options"); }
                }
            }
        }

        // --- dock, terminal, scrollbar ---
        HorizontalLayout {
            vertical-stretch: 1;
            Rectangle {
                width: 22px;
                background: Theme.sidebar-bg;
                VerticalLayout {
                    padding-top: 2px;
                    padding-left: 1px;
                    spacing: 2px;
                    alignment: start;
                    DockTab {
                        label: root.dock-label-sessions;
                        active: root.sessions-open;
                        clicked => {
                            root.sessions-open = !root.sessions-open;
                            root.active-open = false;
                            root.commands-open = false;
                            root.scratch-open = false;
                        }
                    }
                    DockTab {
                        label: root.dock-label-active;
                        active: root.active-open;
                        clicked => {
                            root.active-open = !root.active-open;
                            root.sessions-open = false;
                            root.commands-open = false;
                            root.scratch-open = false;
                        }
                    }
                    DockTab {
                        label: root.dock-label-commands;
                        active: root.commands-open;
                        clicked => {
                            root.commands-open = !root.commands-open;
                            root.sessions-open = false;
                            root.active-open = false;
                            root.scratch-open = false;
                        }
                    }
                    DockTab {
                        label: root.dock-label-scratch;
                        active: root.scratch-open;
                        clicked => {
                            root.scratch-open = !root.scratch-open;
                            root.sessions-open = false;
                            root.active-open = false;
                            root.commands-open = false;
                        }
                    }
                }
            }
            if root.sessions-open: SessionManagerPanel {
                width: root.dock-width;
                rows: root.session-rows;
                can-paste: root.session-can-paste;
                selected <=> root.session-selected;
                activate(i) => { root.session-activate(i); }
                toggle(i) => { root.session-toggle(i); }
                pick(i, add) => { root.session-pick(i, add); }
                action(name) => { root.session-action(name); }
                filter-changed(text) => { root.session-filter(text); }
                pass-key(text, control, alt, shift, meta) => {
                    root.focus-terminal();
                    root.terminal-key(text, control, alt, shift, meta)
                }
            }
            if root.active-open: ActiveSessionsPanel {
                width: root.dock-width;
                tabs: root.active-tabs;
                active-tab: root.active-tab;
                pick(i, add) => { root.active-pick(i, add); }
                act(name) => { root.active-act(name); }
                filter-changed(text) => { root.active-filter(text); }
            }
            if root.commands-open: CommandManagerPanel {
                width: root.dock-width;
                rows: root.command-rows;
                selected <=> root.command-selected;
                send(i) => { root.command-send(i); }
                edit(i) => { root.command-edit(i); }
                remove(i) => { root.command-delete(i); }
                toggle-folder(name) => { root.command-folder(name); }
                to-bar(i) => { root.command-to-bar(i); }
                filter-changed(text) => { root.command-filter(text); }
            }
            if root.scratch-open: ScratchpadPanel {
                width: root.dock-width;
                text <=> root.scratch-text;
                target <=> root.cw-target;
                sel-start: root.scratch-sel-start;
                sel-end: root.scratch-sel-end;
                sel-serial: root.scratch-sel-serial;
                act(name) => { root.scratch-act(name); }
            }
            // Drag handle: resizes whichever dock panel is open.
            if root.sessions-open || root.active-open || root.commands-open || root.scratch-open: Rectangle {
                width: 5px;
                background: Theme.sidebar-bg;
                Rectangle {
                    x: 0px;
                    width: 1px;
                    background: Theme.border;
                }
                TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed {
                            root.dock-width = max(150px, min(600px, root.dock-width + self.mouse-x - self.pressed-x));
                        }
                    }
                }
            }
            if root.sessions-open || root.active-open || root.commands-open || root.scratch-open: Rectangle {
                width: 1px;
                background: Theme.border;
            }
            // Session tabs above the terminal only, beside the dock (as in SecureCRT).
            VerticalLayout {
            horizontal-stretch: 1;
            tab-strip := Rectangle {
                // A dragged tab's pointer, and the tab it would land next to (-1: none).
                property <length> drag-x: -1px;
                property <int> drop: -1;
                property <bool> after;
                height: 27px;
                background: Theme.tabbar-bg;
                // One strip per tab group, over its column of the terminal area.
                for g in root.group-count: HorizontalLayout {
                    x: 4px + g * root.term-width / root.group-count;
                    width: g == 0 && root.group-count == 1 ? parent.width - 4px : root.term-width / root.group-count;
                    height: parent.height;
                    padding-top: 2px;
                    spacing: 1px;
                    alignment: start;
                    for tab[i] in root.tabs: HorizontalLayout {
                        if tab.group == g: SessionTab {
                            title: tab.title;
                            protocol: tab.protocol;
                            state: tab.state;
                            strip: tab.color;
                            active: tab.shown;
                            focused: i == root.active-tab;
                            activity: tab.activity;
                            scripting: tab.scripting;
                            locked: tab.locked;
                            group: tab.group;
                            group-count: root.group-count;
                            select => { root.select-tab(i); }
                            close => { root.close-tab(i); }
                            action(name) => { root.tab-action(i, name); }
                            drag-x: tab-strip.drag-x;
                            drag-moved(x) => { tab-strip.drag-x = x; }
                            changed drop-side => {
                                if self.drop-side != 0 {
                                    tab-strip.drop = i;
                                    tab-strip.after = self.drop-side > 0;
                                } else if tab-strip.drop == i {
                                    tab-strip.drop = -1;
                                }
                            }
                            dropped(x) => {
                                if tab-strip.drop >= 0 {
                                    root.tab-action(i, "move-to-" + tab-strip.drop + (tab-strip.after ? "-after" : ""));
                                    tab-strip.drop = -1;
                                } else if root.group-count > 1 {
                                    root.tab-action(i, "group-to-" + max(0, min(root.group-count - 1, floor((x - tab-strip.absolute-position.x - 4px) / (root.term-width / root.group-count)))));
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
            vertical-stretch: 1;
            // Outer frame gives the terminal a small margin in the scheme's background.
            Rectangle {
                horizontal-stretch: 1;
                background: root.terminal-bg;
            term-area := Rectangle {
                x: 4px;
                y: 2px;
                width: parent.width - 6px;
                height: parent.height - 4px;
                for g in root.group-count - 1: Rectangle {
                    x: (g + 1) * parent.width / root.group-count - 1px;
                    width: 1px;
                    background: Theme.border-strong;
                }
                for pane in root.panes: Rectangle {
                    x: pane.titled ? pane.x - 1px : pane.x;
                    y: pane.titled ? pane.y - 18px : pane.y;
                    width: pane.titled ? pane.width + 2px : pane.width;
                    height: pane.titled ? pane.height + 19px : pane.height;
                    border-width: pane.titled ? 1px : 0px;
                    border-color: pane.active ? Theme.accent : Theme.border-strong;
                    if pane.titled: Rectangle {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: 17px;
                        background: pane.active ? Theme.accent : Theme.border-strong;
                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: pane.title;
                            color: pane.active ? Theme.text-on-accent : Theme.text;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Image {
                        x: pane.titled ? 1px : 0px;
                        y: pane.titled ? 18px : 0px;
                        width: pane.width;
                        height: pane.height;
                        source: pane.image;
                        image-fit: fill;
                        image-rendering: pixelated;
                    }
                }
                if root.tabs.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: "OpenCRT";
                        color: #d0d0d0;
                        font-size: 28px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "File > Quick Connect, or type user@host in the toolbar's connect bar.";
                        color: #909090;
                        horizontal-alignment: center;
                    }
                }
                term-menu := ContextMenuArea {
                    // With the menu bar hidden it is the way to bring it back, even with no tabs.
                    enabled: !root.mouse-reporting && !root.remote-desktop && (root.tabs.length > 0 || !root.show-menubar);
                    Menu {
                        if !root.show-menubar: MenuItem {
                            title: "Show Menu Bar";
                            activated => { root.action("show-menubar"); }
                        }
                        if !root.show-menubar: MenuSeparator { }
                        MenuItem {
                            title: "Copy";
                            enabled: root.has-selection;
                            activated => { root.action("copy"); }
                        }
                        MenuItem {
                            title: "Copy with Colours";
                            enabled: root.has-selection;
                            activated => { root.action("copy-html"); }
                        }
                        MenuItem {
                            title: "Search the Web";
                            enabled: root.has-selection;
                            activated => { root.action("web-search"); }
                        }
                        MenuItem {
                            title: "Paste";
                            enabled: root.session-live;
                            activated => { root.action("paste"); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: "Select All";
                            activated => { root.action("select-all"); }
                        }
                        MenuItem {
                            title: "Clear Scrollback";
                            activated => { root.action("clear-scrollback"); }
                        }
                        MenuItem {
                            title: "Send Break";
                            enabled: root.session-live;
                            activated => { root.action("send-break"); }
                        }
                    }
                    fs := FocusScope {
                        key-pressed(event) => {
                            return root.terminal-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) ? EventResult.accept : EventResult.reject;
                        }
                        TouchArea {
                            mouse-cursor: root.remote-desktop ? MouseCursor.default : MouseCursor.text;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    fs.focus();
                                }
                                // This TouchArea takes right-clicks before the menu area sees them.
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right && term-menu.enabled) {
                                    if (root.paste-on-right) {
                                        if (root.session-live) {
                                            root.action("paste");
                                        }
                                    } else {
                                        term-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                    }
                                }
                                root.terminal-pointer(
                                    event.kind == PointerEventKind.down ? 0 : event.kind == PointerEventKind.up ? 1 : 2,
                                    event.button == PointerEventButton.left ? 0 : event.button == PointerEventButton.right ? 1 : event.button == PointerEventButton.middle ? 2 : 3,
                                    self.mouse-x,
                                    self.mouse-y,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                    event.modifiers.shift);
                            }
                            scroll-event(event) => {
                                return root.terminal-scroll(event.delta-y, self.mouse-x, self.mouse-y, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) ? EventResult.accept : EventResult.reject;
                            }
                        }
                    }
                }
                for v in root.files-views: FilesBrowser {
                    x: v.x;
                    y: v.y;
                    width: v.width;
                    height: v.height;
                    view: v;
                    click(side, row, ctrl, shift) => { root.files-click(v.tab, side, row, ctrl, shift); }
                    open(side, row) => { root.files-open(v.tab, side, row); }
                    go(side, text) => { root.files-go(v.tab, side, text); }
                    action(side, name) => { root.files-action(v.tab, side, name); }
                    filter(side, text) => { root.files-filter(v.tab, side, text); }
                }
                Rectangle {
                    background: #ffffff38;
                    visible: root.bell;
                }
            }
            }
            TermScrollBar {
                offset: root.scroll-offset;
                history: root.scroll-history;
                rows: root.scroll-rows;
                set-fraction(f) => { root.scrollbar-set(f); }
            }
            }
            }
        }

        // --- button bar (View > Button Bar) ---
        if root.show-button-bar: Rectangle {
            height: 28px;
            background: Theme.toolbar-bg;
            Rectangle {
                height: 1px;
                y: 0px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 4px;
                alignment: start;
                for b in root.bar-buttons: BarButtonView {
                    label: b.label;
                    tint: b.color;
                    clicked => { root.bar-button(b.index); }
                    edit => { root.bar-button-edit(b.index); }
                    remove => { root.bar-button-delete(b.index); }
                }
                Rectangle {
                    width: 22px;
                    border-radius: 3px;
                    background: add-touch.has-hover ? Theme.hover-bg : transparent;
                    Text {
                        text: "+";
                        font-size: 14px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    add-touch := TouchArea {
                        clicked => { root.bar-button-edit(-1); }
                    }
                }
                if root.bar-buttons.length == 0: Text {
                    text: "Add a button that sends a command, e.g. show version\\r";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // --- hex view (View > Hex View) ---
        if root.hex-view: Rectangle {
            height: 170px;
            background: Theme.input-bg;
            // Keep the newest bytes in view.
            property <int> count: root.hex-lines.length;
            changed count => {
                hex-list.content-y = min(0px, hex-list.visible-height - self.count * 17px);
            }
            Rectangle {
                height: 1px;
                y: 0px;
                background: Theme.border;
            }
            if root.hex-lines.length == 0: Text {
                text: "Nothing received yet in this tab.";
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            hex-list := ListView {
                y: 1px;
                height: parent.height - 1px;
                for line in root.hex-lines: Text {
                    x: 8px;
                    height: 17px;
                    text: line;
                    font-family: "IBM Plex Mono";
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        // --- command window (View > Command Window): compose a line, Enter sends it ---
        if root.command-window: Rectangle {
            height: 32px;
            background: Theme.toolbar-bg;
            Rectangle {
                height: 1px;
                y: 0px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    text: "Send to";
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    ComboBox {
                        width: 130px;
                        model: ["the active tab", "all tabs", "tabs on screen"];
                        current-index <=> root.cw-target;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    CompactInput {
                        placeholder: root.cw-immediate ? "characters are sent as you type; Enter sends Enter" : "type a command and press Enter";
                        text <=> root.cw-text;
                        submitted(text) => { root.command-line(text); }
                        edited(text) => {
                            if (root.cw-immediate) {
                                root.command-chars(text);
                            }
                        }
                        init => { self.focus-input(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    // "History" first, then the lines sent; picking one fills the input.
                    ComboBox {
                        width: 150px;
                        model: root.cw-history.length > 0 ? root.cw-history : ["History"];
                        enabled: root.cw-history.length > 1;
                        selected(value) => {
                            if (self.current-index > 0) {
                                root.cw-text = value;
                                self.current-index = 0;
                            }
                        }
                    }
                }
                CheckBox {
                    text: "Send characters immediately";
                    checked <=> root.cw-immediate;
                }
            }
        }

        // --- find bar (Edit > Find) ---
        if root.find-open: Rectangle {
            height: 38px;
            background: Theme.toolbar-bg;
            Rectangle {
                height: 1px;
                y: 0px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Find:";
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    find-input := CompactInput {
                        width: 240px;
                        placeholder: "text to find (Enter = next)";
                        submitted(text) => { root.find(text, match-case.checked, false); }
                        init => { self.focus-input(); }
                    }
                }
                Button {
                    text: "Next";
                    clicked => { root.find(find-input.text, match-case.checked, false); }
                }
                Button {
                    text: "Previous";
                    clicked => { root.find(find-input.text, match-case.checked, true); }
                }
                match-case := CheckBox {
                    text: "Match case";
                }
                Text {
                    text: root.find-status;
                    color: Theme.status-error;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                x: parent.width - 26px;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: 3px;
                background: find-close.has-hover ? Theme.border-strong : transparent;
                Text {
                    text: "×";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                find-close := TouchArea {
                    clicked => {
                        root.find-open = false;
                        root.focus-terminal();
                    }
                }
            }
        }

        // --- status bar ---
        if root.show-statusbar: Rectangle {
            height: 22px;
            background: Theme.toolbar-bg;
            Rectangle {
                height: 1px;
                y: 0px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 6px;
                Text {
                    text: root.status-text;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.update-version != "": StatusCell {
                    text: "OpenCRT " + root.update-version + " available";
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if root.dialog == 0 {
                                root.dialog = 4;
                            }
                        }
                    }
                }
                StatusCell {
                    text: root.status-cipher;
                    min-cell-width: 120px;
                }
                StatusCell {
                    text: root.status-pos;
                    min-cell-width: 56px;
                }
                StatusCell {
                    text: root.status-size;
                    min-cell-width: 110px;
                }
                StatusCell {
                    text: root.status-emulation;
                    min-cell-width: 50px;
                }
                // Typing goes to every connected tab (Edit > Send Input to All Tabs).
                if root.send-to-all: StatusCell {
                    text: "ALL TABS";
                    min-cell-width: 64px;
                }
                // The active tab is writing a log file.
                if root.logging: StatusCell {
                    text: "LOG";
                    min-cell-width: 36px;
                }
                if root.show-locks: StatusCell {
                    text: "CAP";
                    dim: !root.caps-on;
                    min-cell-width: 36px;
                }
                if root.show-locks: StatusCell {
                    text: "NUM";
                    dim: !root.num-on;
                    min-cell-width: 38px;
                }
            }
        }
    }

    // --- modal dialogs ---
    if root.dialog == 1: HostKeyDialog {
        host: root.hostkey-host;
        key-type: root.hostkey-type;
        fingerprint: root.hostkey-fingerprint;
        answer(choice) => { root.hostkey-answer(choice); }
    }
    if root.dialog == 2: AuthDialog {
        title: root.auth-title;
        instructions: root.auth-instructions;
        fields: root.auth-fields;
        answers <=> root.auth-answers;
        can-save: root.auth-can-save;
        save <=> root.auth-save;
        credentials: root.auth-credentials;
        credential <=> root.auth-credential;
        error: root.auth-error;
        answer(ok) => { root.auth-answer(ok); }
    }
    if root.dialog == 3: QuickConnectDialog {
        protocol <=> root.qc-protocol;
        line-data <=> root.qc-line-data;
        line-parity <=> root.qc-line-parity;
        line-stop <=> root.qc-line-stop;
        line-flow <=> root.qc-line-flow;
        serial-port <=> root.qc-serial-port;
        baud <=> root.qc-baud;
        serial-ports: root.serial-ports;
        error: root.qc-error;
        host <=> root.qc-host;
        port <=> root.qc-port;
        user <=> root.qc-user;
        key-file <=> root.qc-key;
        save-session <=> root.qc-save;
        connect => { root.quick-connect(); }
        browse(field) => { root.browse(field); }
        cancel => {
            root.dialog = 0;
            root.focus-terminal();
        }
    }
    if root.dialog == 5: SessionOptionsDialog {
        title: "Session Options - " + (root.so-name == "" ? "New Session" : root.so-name);
        category <=> root.so-category;
        protocol <=> root.so-protocol;
        line-data <=> root.so-line-data;
        line-parity <=> root.so-line-parity;
        line-stop <=> root.so-line-stop;
        line-flow <=> root.so-line-flow;
        serial-port <=> root.so-serial-port;
        baud <=> root.so-baud;
        serial-ports: root.serial-ports;
        name <=> root.so-name;
        folder <=> root.so-folder;
        host <=> root.so-host;
        port <=> root.so-port;
        user <=> root.so-user;
        key-file <=> root.so-key;
        cert-file <=> root.so-cert;
        log-file <=> root.so-log;
        logon-script <=> root.so-script;
        logon-text <=> root.so-logon-text;
        jump-host <=> root.so-jump;
        remote-command <=> root.so-command;
        notes <=> root.so-notes;
        sftp <=> root.so-sftp;
        dial-number <=> root.so-dial-number;
        modem-init <=> root.so-modem-init;
        tls <=> root.so-tls;
        pre-connect <=> root.so-pre-connect;
        proxy <=> root.so-proxy;
        template: root.so-template;
        many: root.so-many;
        tab-color <=> root.so-tab-color;
        backspace-ctrl-h <=> root.so-backspace-ctrl-h;
        emulation <=> root.so-emulation;
        key-map <=> root.so-key-map;
        button-bar <=> root.so-button-bar;
        columns <=> root.so-columns;
        rows <=> root.so-rows;
        deccolm <=> root.so-deccolm;
        rdp-width <=> root.so-rdp-width;
        rdp-height <=> root.so-rdp-height;
        rdp-scale <=> root.so-rdp-scale;
        rdp-speed <=> root.so-rdp-speed;
        rdp-sound <=> root.so-rdp-sound;
        rdp-share <=> root.so-rdp-share;
        rdp-h264 <=> root.so-rdp-h264;
        terminal-type <=> root.so-term;
        encoding <=> root.so-encoding;
        encoding-names: root.encoding-names;
        legacy <=> root.so-legacy;
        compression <=> root.so-compression;
        forward-agent <=> root.so-forward-agent;
        forward-x11 <=> root.so-forward-x11;
        log-timestamps <=> root.so-log-timestamps;
        log-connect <=> root.so-log-connect;
        log-disconnect <=> root.so-log-disconnect;
        log-line <=> root.so-log-line;
        anti-idle <=> root.so-anti-idle;
        anti-idle-secs <=> root.so-anti-idle-secs;
        anti-idle-protocol <=> root.so-anti-idle-protocol;
        forward-rows: root.so-forward-rows;
        credential-choices: root.credential-choices;
        credential <=> root.so-credential;
        forward-selected <=> root.so-forward-selected;
        forward-edit(i) => { root.forward-edit(i); }
        forward-remove(i) => { root.forward-remove(i); }
        scheme-index <=> root.so-scheme;
        scheme-choices: root.scheme-choices;
        keyword-set-choices: root.so-keyword-set-choices;
        keyword-set <=> root.so-keyword-set;
        error: root.so-error;
        ok => { root.session-options-ok(); }
        browse(field) => { root.browse(field); }
        cancel => {
            root.dialog = 0;
            root.focus-terminal();
        }
    }
    if root.dialog == 5 && root.fwd-editing: ForwardDialog {
        name <=> root.fwd-name;
        kind <=> root.fwd-kind;
        custom-bind <=> root.fwd-custom-bind;
        bind <=> root.fwd-bind;
        port <=> root.fwd-port;
        custom-host <=> root.fwd-custom-host;
        host <=> root.fwd-host;
        host-port <=> root.fwd-host-port;
        application <=> root.fwd-app;
        arguments <=> root.fwd-args;
        enabled <=> root.fwd-enabled;
        allow <=> root.fwd-allow;
        error: root.fwd-error;
        ok => { root.forward-ok(); }
        cancel => { root.fwd-editing = false; }
        browse(field) => { root.browse(field); }
    }
    if root.dialog == 6: GlobalOptionsDialog {
        category <=> root.go-category;
        font-names: root.font-names;
        font-index <=> root.go-font;
        font-size <=> root.go-font-size;
        scrollback <=> root.go-scrollback;
        keywords <=> root.go-keywords;
        key-map <=> root.go-key-map;
        keepalive <=> root.go-keepalive;
        copy-on-select <=> root.go-copy-on-select;
        word-delimiters <=> root.go-word-delimiters;
        download-folder <=> root.go-download;
        config-folder <=> root.go-config-dir;
        printer <=> root.go-printer;
        print-font <=> root.go-print-font;
        print-margin <=> root.go-print-margin;
        tftp <=> root.go-tftp;
        tftp-allow <=> root.go-tftp-allow;
        drop-protocol <=> root.go-drop;
        browse(field) => { root.browse(field); }
        paste-on-right <=> root.go-paste-on-right;
        paste-on-middle <=> root.go-paste-on-middle;
        host-clipboard <=> root.go-host-clipboard;
        confirm-paste <=> root.go-confirm-paste;
        char-delay <=> root.go-char-delay;
        line-delay <=> root.go-line-delay;
        wait-prompt <=> root.go-wait-prompt;
        web-search <=> root.go-web-search;
        auto-reconnect <=> root.go-auto-reconnect;
        remember-secrets <=> root.go-remember-secrets;
        reopen <=> root.go-reopen;
        menubar <=> root.go-menubar;
        connect-bar <=> root.go-connect-bar;
        confirm-disconnect <=> root.go-confirm-disconnect;
        check-updates <=> root.go-check-updates;
        recent-count <=> root.go-recent-count;
        warn-count <=> root.go-warn-count;
        global-key <=> root.go-global-key;
        cursor-index <=> root.go-cursor;
        bell-index <=> root.go-bell;
        theme-index <=> root.go-theme;
        scheme-index <=> root.go-scheme;
        scheme-names: root.scheme-names;
        error: root.go-error;
        ok => { root.global-options-ok(); }
        cancel => {
            root.dialog = 0;
            root.focus-terminal();
        }
    }
    if root.dialog == 7: ConfirmDialog {
        title: "OpenCRT";
        message: root.confirm-message;
        option: root.confirm-option;
        checked <=> root.confirm-checked;
        answer(yes) => { root.confirm-answer(yes); }
    }
    if root.dialog == 20: QuickOpenDialog {
        rows: root.quick-rows;
        selected <=> root.quick-selected;
        query <=> root.quick-query;
        edited(text) => { root.quick-edited(text); }
        answer(row, files) => { root.quick-answer(row, files); }
    }
    if root.dialog == 19: ScriptEditor {
        title: root.se-title;
        text <=> root.se-text;
        message: root.se-message;
        can-run: root.tabs.length > 0 && !root.session-closed;
        act(name) => { root.se-act(name); }
    }
    if root.dialog == 18: DropDialog {
        message: root.drop-message;
        sftp: root.drop-sftp;
        always <=> root.drop-always;
        answer(how) => { root.drop-answer(how); }
    }
    if root.dialog == 17: PasteDialog {
        message: root.paste-message;
        value <=> root.paste-value;
        answer(ok) => { root.paste-answer(ok); }
    }
    if root.dialog == 8: NameDialog {
        title: root.name-title;
        label: root.name-label;
        value <=> root.name-value;
        answer(ok) => { root.name-answer(ok); }
    }
    if root.dialog == 11: DialogFrame {
        title: "Host Keys";
        dialog-width: 640px;
        Text {
            text: "Keys of the SSH servers you have accepted. Remove one when a server's key has changed for a known reason (for example after a reinstall); you are asked to accept the new key at the next connection.";
            wrap: word-wrap;
            color: Theme.text-secondary;
        }
        Rectangle {
            height: 220px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.border;
            if root.host-keys.length == 0: Text {
                text: "No saved host keys.";
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ListView {
                for entry[i] in root.host-keys: Rectangle {
                    height: 22px;
                    background: i == root.host-key-selected ? Theme.active-row-bg : row-touch.has-hover ? Theme.hover-bg : transparent;
                    row-touch := TouchArea {
                        clicked => { root.host-key-selected = i; }
                    }
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: entry;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                    }
                }
            }
        }
        DialogButtons {
            Button {
                text: "Import...";
                clicked => { root.action("host-key-import"); }
            }
            Button {
                text: "Import SecureCRT...";
                clicked => { root.action("host-key-import-securecrt"); }
            }
            Button {
                text: "Export...";
                enabled: root.host-keys.length > 0;
                clicked => { root.action("host-key-export"); }
            }
            Button {
                text: "Remove";
                enabled: root.host-key-selected >= 0;
                clicked => { root.action("host-key-remove"); }
            }
            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.dialog = 0;
                    root.focus-terminal();
                }
            }
        }
    }
    if root.dialog == 12: DialogFrame {
        title: "Credentials Manager";
        dialog-width: 520px;
        Text {
            text: "Saved logins for SSH2, Telnet and RDP sessions. Pick one in Session Options > Authentication; its password is kept in the system keychain.";
            wrap: word-wrap;
            color: Theme.text-secondary;
        }
        Rectangle {
            height: 200px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 22px;
                    background: Theme.toolbar-bg;
                    HorizontalLayout {
                        padding-left: 6px;
                        spacing: 6px;
                        TableCell { text: "Name"; width: 200px; color: Theme.text-secondary; }
                        TableCell { text: "Username"; horizontal-stretch: 1; preferred-width: 10px; color: Theme.text-secondary; }
                    }
                }
                ListView {
                    for row[i] in root.credential-rows: Rectangle {
                        height: 21px;
                        background: i == root.credential-selected ? Theme.active-row-bg : cred-touch.has-hover ? Theme.hover-bg : transparent;
                        cred-touch := TouchArea {
                            clicked => { root.credential-selected = i; }
                            double-clicked => {
                                root.credential-selected = i;
                                root.credential-edit(i);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 6px;
                            TableCell { text: row.name; width: 200px; }
                            TableCell { text: row.user == "" ? "(session's own)" : row.user; horizontal-stretch: 1; preferred-width: 10px; color: row.user == "" ? Theme.text-secondary : Theme.text; }
                        }
                    }
                }
            }
        }
        DialogButtons {
            Button {
                text: "Add...";
                clicked => { root.credential-edit(-1); }
            }
            Button {
                text: "Edit...";
                enabled: root.credential-selected >= 0 && root.credential-selected < root.credential-rows.length;
                clicked => { root.credential-edit(root.credential-selected); }
            }
            Button {
                text: "Remove";
                enabled: root.credential-selected >= 0 && root.credential-selected < root.credential-rows.length;
                clicked => { root.credential-remove(root.credential-selected); }
            }
            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.dialog = 0;
                    root.focus-terminal();
                }
            }
        }
    }
    if root.dialog == 15: DialogFrame {
        title: "Firewalls";
        dialog-width: 560px;
        Text {
            text: "Proxies and gateways defined once and used by name: type a firewall's name into a session's Proxy field (Session Options > Connection).";
            wrap: word-wrap;
            color: Theme.text-secondary;
        }
        Rectangle {
            height: 180px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 22px;
                    background: Theme.toolbar-bg;
                    HorizontalLayout {
                        padding-left: 6px;
                        spacing: 6px;
                        TableCell { text: "Name"; width: 180px; color: Theme.text-secondary; }
                        TableCell { text: "Proxy"; horizontal-stretch: 1; preferred-width: 10px; color: Theme.text-secondary; }
                    }
                }
                ListView {
                    for row[i] in root.firewall-rows: Rectangle {
                        height: 21px;
                        background: i == root.firewall-selected ? Theme.active-row-bg : fw-touch.has-hover ? Theme.hover-bg : transparent;
                        fw-touch := TouchArea {
                            clicked => { root.firewall-selected = i; }
                            double-clicked => {
                                root.firewall-selected = i;
                                root.firewall-edit(i);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 6px;
                            TableCell { text: row.name; width: 180px; }
                            TableCell { text: row.user; horizontal-stretch: 1; preferred-width: 10px; }
                        }
                    }
                }
            }
        }
        DialogButtons {
            Button {
                text: "Add...";
                clicked => { root.firewall-edit(-1); }
            }
            Button {
                text: "Edit...";
                enabled: root.firewall-selected >= 0 && root.firewall-selected < root.firewall-rows.length;
                clicked => { root.firewall-edit(root.firewall-selected); }
            }
            Button {
                text: "Remove";
                enabled: root.firewall-selected >= 0 && root.firewall-selected < root.firewall-rows.length;
                clicked => { root.firewall-remove(root.firewall-selected); }
            }
            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.dialog = 0;
                    root.focus-terminal();
                }
            }
        }
    }
    if root.dialog == 15 && root.fw-editing: FirewallDialog {
        name <=> root.fw-name;
        kind <=> root.fw-kind;
        host <=> root.fw-host;
        port <=> root.fw-port;
        user <=> root.fw-user;
        password <=> root.fw-password;
        template <=> root.fw-template;
        has-password: root.fw-has-password;
        error: root.fw-error;
        ok => { root.firewall-ok(); }
        cancel => { root.fw-editing = false; }
    }
    if root.dialog == 16: SchemesDialog {
        names: root.scheme-names;
        selected <=> root.sc-selected;
        name <=> root.sc-name;
        fg <=> root.sc-fg;
        bg <=> root.sc-bg;
        cursor <=> root.sc-cursor;
        selection <=> root.sc-selection;
        ansi <=> root.sc-ansi;
        swatches: root.sc-swatches;
        editable: root.sc-editable;
        error: root.sc-error;
        pick(i) => { root.scheme-pick(i); }
        edited => { root.scheme-edited(); }
        new-scheme => { root.scheme-new(); }
        delete-scheme => { root.scheme-delete(); }
        save => { root.scheme-save(); }
        close => {
            root.dialog = 0;
            root.focus-terminal();
        }
    }
    if root.dialog == 13: ScriptDialog {
        title: root.script-title;
        text: root.script-text;
        input: root.script-input;
        secret: root.script-secret;
        value <=> root.script-value;
        answer(ok) => { root.script-answer(ok); }
    }
    if root.dialog == 14: DialogFrame {
        title: "Agent Keys";
        dialog-width: 600px;
        Text {
            text: "Keys held by OpenCRT's own SSH agent. While it holds keys, sessions without a key file log in with them and forwarded agents use them; otherwise the system's agent is used. Keys stay in memory until OpenCRT closes.";
            wrap: word-wrap;
            color: Theme.text-secondary;
        }
        Rectangle {
            height: 180px;
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.border;
            if root.agent-rows.length == 0: Text {
                text: "No keys loaded.";
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ListView {
                for entry[i] in root.agent-rows: Rectangle {
                    height: 22px;
                    background: i == root.agent-selected ? Theme.active-row-bg : agent-touch.has-hover ? Theme.hover-bg : transparent;
                    agent-touch := TouchArea {
                        clicked => { root.agent-selected = i; }
                    }
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: entry;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                    }
                }
            }
        }
        CheckBox {
            text: "Load these keys when OpenCRT starts (their file names are saved; passphrases are asked for)";
            checked <=> root.agent-load;
        }
        DialogButtons {
            Button {
                text: "Add...";
                clicked => { root.action("agent-add"); }
            }
            Button {
                text: "Remove";
                enabled: root.agent-selected >= 0 && root.agent-selected < root.agent-rows.length;
                clicked => { root.action("agent-remove"); }
            }
            Button {
                text: "Close";
                primary: true;
                clicked => { root.action("agent-close"); }
            }
        }
    }
    if root.dialog == 12 && root.cred-editing: CredentialDialog {
        name <=> root.cred-name;
        user <=> root.cred-user;
        password <=> root.cred-password;
        confirm <=> root.cred-confirm;
        has-password: root.cred-has-password;
        error: root.cred-error;
        ok => { root.credential-ok(); }
        cancel => { root.cred-editing = false; }
    }
    if root.dialog == 10: DialogFrame {
        title: "Create Public Key";
        dialog-width: 500px;
        Text {
            text: "Creates a key pair in OpenSSH format. Add the public key (copied to the clipboard when done) to ~/.ssh/authorized_keys on the server, or use Tools > Public Key Assistant.";
            wrap: word-wrap;
            color: Theme.text-secondary;
        }
        FieldRow {
            label: "Type:";
            ComboBox {
                model: root.kg-types;
                current-index <=> root.kg-type;
                selected => { root.keygen-type(); }
            }
        }
        FieldRow {
            label: "Passphrase:";
            LineEdit {
                text <=> root.kg-passphrase;
                input-type: password;
                placeholder-text: "recommended";
                init => { self.focus(); }
                accepted => { root.keygen-ok(); }
            }
        }
        FieldRow {
            label: "Confirm:";
            LineEdit {
                text <=> root.kg-confirm;
                input-type: password;
                accepted => { root.keygen-ok(); }
            }
        }
        FieldRow {
            label: "Comment:";
            LineEdit {
                text <=> root.kg-comment;
                accepted => { root.keygen-ok(); }
            }
        }
        FieldRow {
            label: "Save as:";
            LineEdit {
                text <=> root.kg-file;
                accepted => { root.keygen-ok(); }
            }
            Button {
                text: "...";
                clicked => { root.browse("kg-file"); }
            }
        }
        if root.kg-error != "": Text {
            text: root.kg-error;
            color: Theme.status-error;
            wrap: word-wrap;
        }
        DialogButtons {
            Button {
                text: root.kg-busy ? "Creating..." : "Create";
                primary: true;
                enabled: !root.kg-busy;
                clicked => { root.keygen-ok(); }
            }
            Button {
                text: "Cancel";
                clicked => {
                    root.dialog = 0;
                    root.focus-terminal();
                }
            }
        }
    }
    if root.dialog == 9: DialogFrame {
        title: root.bb-title;
        dialog-width: 460px;
        FieldRow {
            label: "Label:";
            LineEdit {
                text <=> root.bb-label;
                init => { self.focus(); }
                accepted => { root.bar-button-ok(); }
            }
        }
        FieldRow {
            label: "Action:";
            ComboBox {
                model: ["Send text", "Run a script", "Menu command", "Run a program", "Telnet command"];
                current-index <=> root.bb-kind;
            }
        }
        FieldRow {
            label: root.bb-kind == 0 ? "Send:" : root.bb-kind == 1 ? "Script file:" : root.bb-kind == 2 ? "Menu command:" : root.bb-kind == 3 ? "Program:" : "Command:";
            LineEdit {
                text <=> root.bb-text;
                placeholder-text: root.bb-kind == 0 ? "e.g. show version\\r" : root.bb-kind == 1 ? "e.g. /home/me/scripts/login.rhai" : root.bb-kind == 2 ? "e.g. clear-screen, reconnect, sftp-tab" : root.bb-kind == 3 ? "e.g. wireshark -k" : "brk, ip, ao, ayt, ec, el, ga or nop";
                accepted => { root.bar-button-ok(); }
            }
        }
        if !root.bb-show-folder: FieldRow {
            label: "Colour:";
            ComboBox {
                model: ["None", "Red", "Orange", "Yellow", "Green", "Blue", "Purple"];
                current-index <=> root.bb-color;
            }
        }
        if !root.bb-show-folder: FieldRow {
            label: "Bar:";
            LineEdit {
                text <=> root.bb-bar;
                placeholder-text: "blank: the default bar (sessions choose theirs)";
                accepted => { root.bar-button-ok(); }
            }
        }
        if root.bb-show-folder: FieldRow {
            label: "Folder:";
            LineEdit {
                text <=> root.bb-folder;
                placeholder-text: "optional, e.g. Cisco";
                accepted => { root.bar-button-ok(); }
            }
        }
        if root.bb-kind == 0: Text {
            text: "\\r is Enter, \\n a line feed, \\t Tab, \\e Escape and \\\\ a backslash.";
            color: Theme.text-secondary;
            font-size: 11px;
        }
        if root.bb-error != "": Text {
            text: root.bb-error;
            color: Theme.status-error;
        }
        DialogButtons {
            Button {
                text: "OK";
                primary: true;
                clicked => { root.bar-button-ok(); }
            }
            Button {
                text: "Cancel";
                clicked => {
                    root.dialog = 0;
                    root.focus-terminal();
                }
            }
        }
    }
    if root.dialog == 4: AboutDialog {
        version: root.version;
        settings-dir: root.settings-dir;
        update-version: root.update-version;
        update-status: root.update-status;
        update-installable: root.update-installable;
        check-updates => { root.action("check-updates"); }
        install-update => { root.action("install-update"); }
        release-notes => { root.action("release-notes"); }
        close => {
            root.dialog = 0;
            root.focus-terminal();
        }
    }
}
