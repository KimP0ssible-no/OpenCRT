    // Right-click in the terminal pastes instead of opening the menu.
    in property <bool> paste-on-right;
    in-out property <int> go-scheme;
    in property <string> go-error;
    in property <string> confirm-message;
    in property <string> confirm-option;
    in-out property <bool> confirm-checked;
    in property <string> name-title;
    in property <string> name-label;
    in-out property <string> name-value;
    in property <string> hostkey-host;
    in property <string> hostkey-type;
    in property <string> hostkey-fingerprint;
    in property <string> auth-title;
    in property <string> auth-instructions;
    in property <[PromptField]> auth-fields;
    in-out property <[string]> auth-answers;
    in property <bool> auth-can-save;
    in property <[string]> auth-credentials;
    in-out property <int> auth-credential;
