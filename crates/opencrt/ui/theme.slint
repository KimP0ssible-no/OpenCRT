// OpenCRT window chrome colours. They follow the system: the style's light or
// dark neutrals (system setting, or Global Options > General > Theme) and the
// system accent colour.

import { Palette } from "std-widgets.slint";

export global Theme {
    // Back on "System" after a forced choice the scheme reads unknown and the
    // style follows the system itself; its dark background tells which.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark
        || (Palette.color-scheme == ColorScheme.unknown && Palette.background == #1C1C1C);

    out property <brush> window-bg: Palette.alternate-background;
    out property <brush> toolbar-bg: Palette.alternate-background;
    out property <brush> tabbar-bg: Palette.alternate-background;
    out property <brush> tab-inactive-bg: Palette.alternate-background;
    out property <brush> tab-active-bg: Palette.background;
    out property <brush> sidebar-bg: Palette.background;
    out property <brush> panel-bg: Palette.background;
    out property <brush> input-bg: dark ? #202020 : #FFFFFF;
    out property <brush> border: dark ? #3A3A3A : #D4D4D4;
    out property <brush> border-strong: dark ? #555555 : #B4B4B4;
    out property <brush> text: Palette.foreground;
    out property <brush> text-secondary: dark ? #FFFFFFA6 : #0000009E;
    out property <brush> text-disabled: dark ? #FFFFFF5E : #0000005E;
    out property <brush> accent: Palette.accent-background;
    out property <brush> text-on-accent: Palette.accent-foreground;
    out property <brush> focus-ring: Palette.accent-background;
    out property <brush> hover-bg: dark ? #FFFFFF14 : #0000000D;
    out property <brush> active-row-bg: Palette.accent-background.with-alpha(dark ? 0.35 : 0.2);
    out property <brush> scrollbar: dark ? #5A5A5A : #C4C4C4;
    out property <brush> status-connected: dark ? #6CCB5F : #0F7B0F;
    out property <brush> status-connecting: dark ? #FCE100 : #9D5D00;
    out property <brush> status-disconnected: dark ? #9A9A9A : #8A8A8A;
    out property <brush> status-error: dark ? #FF99A4 : #C42B1C;
}
